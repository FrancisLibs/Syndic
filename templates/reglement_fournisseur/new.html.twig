{% extends 'base.html.twig' %}

{% block title %}
	Nouveau règlement fournisseur
{% endblock %}

{% block body %}

	<div class="container-fluid">

		<div class="d-flex justify-content-between align-items-baseline mb-4">

			<div>
				<h1>Règlement fournisseur</h1>

				<h4 class="text-secondary">
					{{ exercice.nom }}
				</h4>
			</div>

		</div>

		{# ============================ #}
		{# Choix du fournisseur         #}
		{# ============================ #}

		<div class="card mb-4"> <div class="card-header">
				Fournisseur
			</div>

			<div class="card-body">

				<form method="get" action="{{ path('app_reglement_fournisseur_new') }}">

					<div class="row align-items-end">

						<div class="col-md-5">

							<label for="fournisseur" class="form-label">
								Fournisseur
							</label>

							<select name="fournisseur" id="fournisseur" class="form-select" onchange="this.form.submit();">

								<option value="">
									Choisir...
								</option>

								{% for item in fournisseurs %}

									<option value="{{ item.id }}" {% if fournisseur and fournisseur.id == item.id %} selected {% endif %}>
										{{ item.nom }}
									</option>

								{% endfor %}

							</select>

						</div>

					</div>

				</form>

			</div>

		</div>

		{# ======================================== #}
		{# Situation comptable du fournisseur       #}
		{# ======================================== #}


		{% if fournisseur is not null %}

			<div class="card mb-4">
				<div class="card-header">
					Situation comptable du fournisseur
				</div>

				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<strong>Fournisseur :</strong>
							{{ fournisseur.nom }}
						</div>

						<div class="col-md-6 text-end">
							<strong>Solde comptable :</strong>

							<span class="{{ soldeFournisseur > 0 ? 'text-danger' : (soldeFournisseur < 0 ? 'text-success' : '') }}">
								{{ soldeFournisseur|number_format(2, ',', ' ') }} €
							</span>
						</div>
					</div>
				</div>
			</div>

		{% endif %}


		{% if fournisseur %}

			<form method="post" action="{{ path('app_reglement_fournisseur_new') }}">

				<input type="hidden" name="_token" value="{{ csrf_token('reglement-fournisseur') }}">

				<input type="hidden" name="fournisseur_id" value="{{ fournisseur.id }}">


				<div class="card mb-4">

					<div class="card-header">
						Détails du règlement
					</div>

					<div class="card-body">

						<div class="mb-4">

							<strong>
								{{ fournisseur.nom }}
							</strong>

							{% if fournisseur.compte %}

								<div class="text-muted">
									Compte :
									{{ fournisseur.compte.numero }}
									-
									{{ fournisseur.compte.libelle }}
								</div>

							{% endif %}

						</div>


						<div class="row">

							<div class="col-md-3">

								<label for="date_reglement" class="form-label">
									Date du règlement
								</label>

								<input type="date" name="date_reglement" id="date_reglement" class="form-control" required>

							</div>


							<div class="col-md-3">

								<label for="montant" class="form-label">
									Montant
								</label>

								<div class="input-group">

									<input type="number" name="montant" id="montant" step="0.01" min="0.01" class="form-control" required>

									<span class="input-group-text">
										€
									</span>

								</div>

							</div>


							<div class="col-md-6">

								<label for="reference" class="form-label">
									Référence
								</label>

								<input type="text" name="reference" id="reference" class="form-control" maxlength="100">

								<div class="form-text">
									Exemple : numéro de virement, chèque ou prélèvement.
								</div>

							</div>

						</div>

					</div>

				</div>

				{# ======================================== #}
				{# Factures à régler                        #}
				{# ======================================== #}

				<div class="card mb-4">

					<div class="card-header">
						Factures à régler
					</div>

					<div class="card-body">

						{% if factures is empty %}

							<div class="alert alert-info mb-0">
								Aucune facture à régler pour ce fournisseur.
							</div>

						{% else %}

							<div class="table-responsive">

								<table class="table table-striped table-hover">

									<thead>
										<tr>
											<th class="text-center">Sélection</th>
											<th>Exercice</th>
											<th>Date</th>
											<th>Numéro</th>
											<th>Libellé</th>
											<th class="text-end">Montant</th>
											<th class="text-end">Déjà réglé</th>
											<th class="text-end">Reste à régler</th>
											<th class="text-end">À régler</th>
										</tr>
									</thead>

									<tbody>

										{% for facture in factures %}

											<tr>

												<td class="text-center">
													<input
														type="checkbox"
														class="form-check-input js-selection-facture"
														data-facture-id="{{ facture.id }}"
													>
												</td>

												<td>
													{{ facture.exercice.nom }}
												</td>

												<td>
													{{ facture.dateFacture|date('d/m/Y') }}
												</td>

												<td>
													{{ facture.numero }}
												</td>

												<td>
													{{ facture.libelle }}
												</td>

												<td class="text-end">
													{{ facture.montantFacture|number_format(2, ',', ' ') }} €
												</td>

												<td class="text-end">
													{{ facture.montantRegle|number_format(2, ',', ' ') }} €
												</td>

												<td class="text-end fw-bold">
													{{ facture.resteARegler|number_format(2, ',', ' ') }} €
												</td>

												<td>
													<input
														type="number"
														name="affectations[{{ facture.id }}]"
														class="form-control text-end js-montant-affectation"
														min="0"
														max="{{ facture.resteARegler|number_format(2, '.', '') }}"
														step="0.01"
														value="0.00"
														data-reste="{{ facture.resteARegler|number_format(2, '.', '') }}"
													>
												</td>
											</tr>

										{% endfor %}

									</tbody>

								</table>

								<div class="d-flex justify-content-end mt-3">
									<div class="text-end">
										<div>
											Total affecté :
											<strong id="total-affectations">0,00 €</strong>
										</div>

										<div>
											Non affecté :
											<strong id="montant-non-affecte">0,00 €</strong>
										</div>

										<div
											id="erreur-affectations"
											class="text-danger d-none"
										>
											Le total des affectations dépasse le montant du règlement.
										</div>
									</div>
								</div>

							</div>

						{% endif %}

					</div>

				</div>


				<div class="d-flex justify-content-between">

					<a href="{{ path('app_reglement_fournisseur_index') }}" class="btn btn-secondary">
						Retour
					</a>

					<button type="submit" class="btn btn-success">
						Enregistrer le règlement
					</button>

				</div>

			</form>

		{% endif %}

	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('assets/js/reglement-fournisseur-affectations.js') }}"></script>
{% endblock %}
