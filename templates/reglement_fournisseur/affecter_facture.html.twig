
{% extends 'base.html.twig' %}

{% block title %}
    Affecter une facture à un règlement
{% endblock %}

{% block body %}

    <h1>Affecter une facture à un règlement</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5>Facture sélectionnée</h5>

            <p>
                <strong>Fournisseur :</strong>
                {{ facture.fournisseur.nom }}
            </p>

            <p>
                <strong>Facture :</strong>
                {{ facture.numero ?: facture.id }}
            </p>

            <p>
                <strong>Libellé :</strong>
                {{ facture.libelle }}
            </p>

            <p>
                <strong>Montant à affecter :</strong>
                {{ facture.resteARegler|number_format(2, ',', ' ') }} €
            </p>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">
                Sélectionner un règlement existant
            </h5>

            {% if reglements is empty %}

                <div class="alert alert-info">
                    Aucun règlement disponible pour ce fournisseur.
                </div>

            {% else %}

                <form method="post">

                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('affecter-facture-' ~ facture.id) }}"
                    >

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Date</th>
                                    <th>Référence</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-end">Disponible</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for reglement in reglements %}
                                    <tr>
                                        <td>
                                            <input
                                                type="radio"
                                                name="reglement_id"
                                                value="{{ reglement.id }}"
                                                required
                                                {% if reglement.montantNonAffecte < facture.resteARegler %}
                                                disabled
                                                {% endif %}
                                            >
                                        </td>

                                        <td>
                                            {{ reglement.dateReglement|date('d/m/Y') }}
                                        </td>

                                        <td>
                                            {{ reglement.reference ?: '—' }}
                                        </td>

                                        <td class="text-end">
                                            {{ reglement.montant|number_format(2, ',', ' ') }} €
                                        </td>

                                        <td class="text-end">
                                            {{ reglement.montantNonAffecte|number_format(2, ',', ' ') }} €
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a
                            href="{{ path('app_facture_fournisseur_index') }}"
                            class="btn btn-outline-secondary"
                        >
                            Annuler
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Enregistrer l'affectation
                        </button>

                    </div>

                </form>

            {% endif %}

        </div>
    </div>

{% endblock %}
