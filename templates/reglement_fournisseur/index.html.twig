
{% extends 'base.html.twig' %}

{% block title %}
	Paiements fournisseurs
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="mb-0">
				Paiements fournisseurs
			</h1>

			<p class="text-muted mb-0">
				Exercice :
				<strong>{{ exercice.nom }}</strong>
			</p>
		</div>
	</div>

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">

				<table class="table table-hover align-middle mb-0">

					<thead class="table-light">
						<tr>
							<th>Date</th>
							<th>Fournisseur</th>
							<th>Référence</th>
							<th class="text-end">Montant</th>
							<th class="text-end">Affecté</th>
							<th class="text-end">Disponible</th>
							<th class="text-center">État</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>

					<tbody>

						{% for groupe in groupes %}

							<tr class="table-secondary">
								<td colspan="8">
									<strong>
										{{ groupe.fournisseur.nom }}
									</strong>
								</td>
							</tr>

							{% for reglement in groupe.reglements %}

								{% set montantAffecte = reglement.montantAffecte %}
								{% set montantDisponible = reglement.montantNonAffecte %}

								<tr>

									<td class="text-nowrap">
										{{ reglement.dateReglement|date('d/m/Y') }}
									</td>

									<td>
										{{ reglement.fournisseur.nom }}
									</td>

									<td>
										{{ reglement.reference ?: '—' }}
									</td>

									<td class="text-end text-nowrap">
										{{ reglement.montant|number_format(2, ',', ' ') }} €
									</td>

									<td class="text-end text-nowrap">
										{{ montantAffecte|number_format(2, ',', ' ') }} €
									</td>

									<td class="text-end text-nowrap">
										{{ montantDisponible|number_format(2, ',', ' ') }} €
									</td>

									<td class="text-center">

										{% if montantDisponible <= 0 %}

											<span class="badge bg-success">
												Affecté
											</span>

										{% elseif montantAffecte > 0 %}

											<span class="badge bg-warning text-dark">
												Partiel
											</span>

										{% else %}

											<span class="badge bg-secondary">
												Non affecté
											</span>

										{% endif %}

									</td>

									<td class="text-end">

										<div class="d-flex justify-content-end gap-2">

											<a
												href="{{ path('app_reglement_fournisseur_show', {
                                                    id: reglement.id
                                                }) }}"
												class="btn btn-sm btn-outline-primary"
											>
												Voir
											</a>

											{% if not reglement.exercice.cloture %}

												<a
													href="{{ path('app_reglement_fournisseur_edit', {
                                                        id: reglement.id
                                                    }) }}"
													class="btn btn-sm btn-outline-secondary"
												>
													Modifier
												</a>

											{% endif %}

										</div>

									</td>

								</tr>

							{% endfor %}

							<tr class="table-light">

								<td colspan="3" class="text-end">
									<strong>
										Sous-total {{ groupe.fournisseur.nom }}
									</strong>
								</td>

								<td class="text-end text-nowrap">
									<strong>
										{{ groupe.total|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								{% set totalAffecte = 0 %}
								{% set totalDisponible = 0 %}

								{% for reglement in groupe.reglements %}
									{% set totalAffecte = totalAffecte + reglement.montantAffecte %}
									{% set totalDisponible = totalDisponible + reglement.montantNonAffecte %}
								{% endfor %}

								<td class="text-end text-nowrap">
									<strong>
										{{ totalAffecte|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								<td class="text-end text-nowrap">
									<strong>
										{{ totalDisponible|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								<td colspan="2"></td>

							</tr>

						{% else %}

							<tr>
								<td colspan="8" class="text-center text-muted py-4">
									Aucun paiement fournisseur pour cet exercice.
								</td>
							</tr>

						{% endfor %}

					</tbody>

					{% if groupes is not empty %}

						{% set totalGeneralAffecte = 0 %}
						{% set totalGeneralDisponible = 0 %}

						{% for groupe in groupes %}
							{% for reglement in groupe.reglements %}
								{% set totalGeneralAffecte = totalGeneralAffecte + reglement.montantAffecte %}
								{% set totalGeneralDisponible = totalGeneralDisponible + reglement.montantNonAffecte %}
							{% endfor %}
						{% endfor %}

						<tfoot>
							<tr class="table-dark">

								<td colspan="3" class="text-end">
									<strong>Total général</strong>
								</td>

								<td class="text-end text-nowrap">
									<strong>
										{{ totalGeneral|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								<td class="text-end text-nowrap">
									<strong>
										{{ totalGeneralAffecte|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								<td class="text-end text-nowrap">
									<strong>
										{{ totalGeneralDisponible|number_format(2, ',', ' ') }} €
									</strong>
								</td>

								<td colspan="2"></td>

							</tr>
						</tfoot>

					{% endif %}

				</table>

			</div>
		</div>
	</div>

{% endblock %}
