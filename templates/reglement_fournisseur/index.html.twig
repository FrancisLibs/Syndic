{% extends 'base.html.twig' %}

{% block title %}
	Paiements fournisseurs
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="mb-0">Paiements fournisseurs	</h1>
			<p class="text-muted mb-0">
				Exercice :
				<strong>{{ exercice.nom }}</strong>
			</p>
		</div>

	</div>

	<div class="card shadow-sm">

		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th>Date</th>
							<th>Fournisseur</th>
							<th>Référence</th>
							<th class="text-end">Montant</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>

					<tbody>
						{% for reglement in reglements %}
							<tr>
								<td class="text-nowrap">{{ reglement.dateReglement|date('d/m/Y') }}</td>
								<td>{{ reglement.fournisseur.nom }}</td>
								<td>{{ reglement.reference ?: '—' }}</td>
								<td class="text-end text-nowrap">{{ reglement.montant|number_format(2, ',', ' ')}}€</td>
								<td class="text-end">
									<div class="d-flex justify-content-end gap-2">
										<a href="{{ path( 'app_reglement_fournisseur_show', { id: reglement.id } ) }}" class="btn btn-sm btn-outline-primary">
											Voir
										</a>
										{% if not reglement.exercice.cloture %}
											<a class="btn btn-sm btn-outline-secondary" href="{{ path( 'app_reglement_fournisseur_edit', { id: reglement.id } ) }}">
												Modifier
											</a>
										{% endif %}
									</div>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="8" class="text-center text-muted py-4">
									Aucun paiement fournisseur pour cet exercice.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
