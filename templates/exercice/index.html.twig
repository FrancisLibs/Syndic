{% extends 'base.html.twig' %}

{% block title %}Exercice index
{% endblock %}

{% block body %}
	<h1 class="me-5">Liste des exercices</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Nom</th>
				<th>DateDebut</th>
				<th>DateFin</th>
				<th>Statut</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for exercice in exercices %}
				<tr>
					<td>{{ exercice.nom }}</td>
					<td>{{ exercice.dateDebut ? exercice.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ exercice.dateFin ? exercice.dateFin|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ exercice.statut.value }}</td>
					<td class="d-flex align-items-center gap-2">
						<a class="btn btn-sm btn-outline-primary" href="{{ path('app_exercice_show', {'id': exercice.id}) }}">Voir</a>
						<a class="btn btn-sm btn-outline-secondary" href="{{ path('app_exercice_edit', {'id': exercice.id}) }}">Modifier</a>
						{% if exercice.actif %}
							<span class="badge bg-success">
								Actif
							</span>
						{% else %}
							<form method="post" action="{{ path( 'app_exercice_activer', {id: exercice.id} ) }}">
								<button class="btn btn-sm btn-primary">
									Activer
								</button>
							</form>
						{% endif %}
						{% if exercice.cloture %}
							<span class="badge bg-warning">
								cloturé
							</span>
						{% else %}
							<form method="post" action="{{ path( 'app_cloture_exercice', {id: exercice.id} ) }}">
								<button class="btn btn-sm btn-danger">
									clôturer
								</button>
							</form>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="5">Aucun enregistrement trouvé</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	<a class="btn btn-primary" href="{{ path('app_exercice_new') }}">Créer un nouvel exercice</a>
{% endblock %}
