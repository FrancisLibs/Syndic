{% extends 'base.html.twig' %}

{% block title %}Exercice index
{% endblock %}

{% block body %}
	<h1 class="me-5">Liste des exercices</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Nom</th>
				<th>DateDebut</th>
				<th>DateFin</th>
				<th>Statut</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for exercice in exercices %}
				<tr>
					<td>{{ exercice.nom }}</td>
					<td>{{ exercice.dateDebut ? exercice.dateDebut|date('d-m-Y H:i:s') : '' }}</td>
					<td>{{ exercice.dateFin ? exercice.dateFin|date('d-m-Y H:i:s') : '' }}</td>
					<td>{{ exercice.statut.value }}</td>
					<td class="d-flex align-items-center gap-2">
						<a class="btn btn-sm btn-outline-primary" href="{{ path('app_exercice_show', {'id': exercice.id}) }}">
							Voir
						</a>
						{# <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_exercice_edit', {'id': exercice.id}) }}">Modifier</a> #}
						{% if exercice.actif %}
							<span class="badge bg-success">
								Actif
							</span>
						{% endif %}

						{% if exercice.cloture %}
							<span class="badge bg-warning">
								Clôturé
							</span>
						{% else %}
							<a class="btn btn-sm btn-outline-danger" href="{{ path('app_cloture_workflow', { id: exercice.id }) }}">
								Assistant de clôture
							</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="5">Aucun enregistrement trouvé</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	{% if exercices is empty %}
		<a class="btn btn-primary" href="{{ path('app_exercice_new') }}">
			Créer le premier exercice
		</a>
	{% endif %}
{% endblock %}
