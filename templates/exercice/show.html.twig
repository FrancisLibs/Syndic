{% extends 'base.html.twig' %}

{% block title %}Exercice
{% endblock %}

{% block body %}
	<h1>{{ exercice.nom }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Copropriété</th>
				<td>{{ exercice.copropriete }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ exercice.nom }}</td>
			</tr>
			<tr>
				<th>DateDebut</th>
				<td>{{ exercice.dateDebut ? exercice.dateDebut|date('d-m-Y H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>DateFin</th>
				<td>{{ exercice.dateFin ? exercice.dateFin|date('d-m-Y H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Statut</th>
				<td>{{ exercice.statut.value }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_exercice_index') }}">Retour à la liste</a>

{% endblock %}
