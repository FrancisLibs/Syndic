{% extends 'base.html.twig' %}

{% block title %}Exercice
{% endblock %}

{% block body %}
	<h1>{{ exercice.nom }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Copropriété</th>
				<td>{{ exercice.copropriete }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ exercice.nom }}</td>
			</tr>
			<tr>
				<th>DateDebut</th>
				<td>{{ exercice.dateDebut ? exercice.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>DateFin</th>
				<td>{{ exercice.dateFin ? exercice.dateFin|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Statut</th>
				<td>{{ exercice.statut.value }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_exercice_index') }}">Retour à la liste</a>
	<a href="{{ path('app_exercice_edit', {'id': exercice.id}) }}">Modifier</a>
	<a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="btn btn-warning"> Régularisations</a>

{% endblock %}
