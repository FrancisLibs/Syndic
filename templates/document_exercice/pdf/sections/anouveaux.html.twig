<h1>À-nouveaux</h1>

		{% if anouveaux.generes %}

			<table class="anouveaux-informations">
				<tbody>
					<tr>
						<th>État</th>
						<td>Écritures d'à-nouveaux générées</td>
					</tr>

					<tr>
						<th>Date</th>
						<td>
							{{ anouveaux.operation.date|date('d/m/Y') }}
						</td>
					</tr>

					<tr>
						<th>Libellé</th>
						<td>
							{{ anouveaux.operation.libelle }}
						</td>
					</tr>
				</tbody>
			</table>

		{% endif %}

		<h2>Synthèse</h2>

		<table class="anouveaux-synthese">
			<tbody>
				<tr>
					<th>Nombre de lignes</th>
					<td class="montant">
						{{ anouveaux.lignes|length }}
					</td>
				</tr>

				<tr>
					<th>Total débit</th>
					<td class="montant">
						{{ anouveaux.totalDebit|number_format(2, ',', ' ') }}
						€
					</td>
				</tr>

				<tr>
					<th>Total crédit</th>
					<td class="montant">
						{{ anouveaux.totalCredit|number_format(2, ',', ' ') }}
						€
					</td>
				</tr>

				<tr>
					<th>Contrôle</th>
					<td>
						{% if anouveaux.estEquilibre %}
							Écritures équilibrées
						{% else %}
							Écritures non équilibrées
						{% endif %}
					</td>
				</tr>
			</tbody>
		</table>

		<h2>Détail des à-nouveaux</h2>

		<table>

			<thead>
				<tr>
					<th>Compte</th>
					<th>Libellé</th>
					<th>Copropriétaire</th>
					<th class="montant">Débit</th>
					<th class="montant">Crédit</th>
				</tr>
			</thead>

			<tbody>

				{% for solde in anouveaux.lignes %}

					<tr>
						<td>
							{{ solde.compte.numero }}
						</td>

						<td>
							{{ solde.compte.libelle }}
						</td>

						<td>
							{{ solde.coproprietaire ? solde.coproprietaire : '-' }}
						</td>

						<td class="montant">
							{% if solde.debit > 0 %}
								{{ solde.debit|number_format(2, ',', ' ') }}
								€
							{% else %}
								-
							{% endif %}
						</td>

						<td class="montant">
							{% if solde.credit > 0 %}
								{{ solde.credit|number_format(2, ',', ' ') }}
								€
							{% else %}
								-
							{% endif %}
						</td>
					</tr>

				{% else %}

					<tr>
						<td colspan="5">
							Aucun à-nouveau à générer.
						</td>
					</tr>

				{% endfor %}

			</tbody>

			<tfoot>
				<tr>
					<th colspan="3">
						Totaux
					</th>

					<th class="montant">
						{{ anouveaux.totalDebit|number_format(2, ',', ' ') }}
						€
					</th>

					<th class="montant">
						{{ anouveaux.totalCredit|number_format(2, ',', ' ') }}
						€
					</th>
				</tr>
			</tfoot>

		</table>