<h1>État de compte</h1>

<h2>{{ exercice.nom }}</h2>

<section class="compte-coproprietaire">

    <div class="compte-coproprietaire-entete">
        <span class="compte-coproprietaire-nom">
            {{ ligne.coproprietaire }}
        </span>

        <span class="compte-coproprietaire-numero">
            Compte {{ ligne.compte.numero }}
        </span>
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Pièce</th>
                <th>Libellé</th>
                <th class="montant">Débit</th>
                <th class="montant">Crédit</th>
                <th class="montant">Solde</th>
            </tr>
        </thead>

        <tbody>
            {% for mvt in ligne.mouvements %}
                <tr>
                    <td>{{ mvt.date|date('d/m/Y') }}</td>
                    <td>{{ mvt.piece }}</td>
                    <td>{{ mvt.libelle }}</td>

                    <td class="montant">
                        {% if mvt.debit != 0 %}
                            {{ mvt.debit|number_format(2, ',', ' ') }}
                        {% endif %}
                    </td>

                    <td class="montant">
                        {% if mvt.credit != 0 %}
                            {{ mvt.credit|number_format(2, ',', ' ') }}
                        {% endif %}
                    </td>

                    <td class="montant">
                        {{ mvt.solde|number_format(2, ',', ' ') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">
                        Aucun mouvement sur cet exercice
                    </td>
                </tr>
            {% endfor %}
        </tbody>

        <tfoot>
            <tr>
                <td colspan="3">Totaux</td>

                <td class="montant">
                    {{ ligne.totalDebit|number_format(2, ',', ' ') }}
                </td>

                <td class="montant">
                    {{ ligne.totalCredit|number_format(2, ',', ' ') }}
                </td>

                <td class="montant">
                    {% if ligne.solde < - 0.01 %}
                        {{ ligne.solde|abs|number_format(2, ',', ' ') }} €
                        en votre faveur

                    {% elseif ligne.solde > 0.01 %}
                        {{ ligne.solde|number_format(2, ',', ' ') }} €
                        à votre charge

                    {% else %}
                        0,00 €
                    {% endif %}
                </td>
            </tr>
        </tfoot>
    </table>

</section>
