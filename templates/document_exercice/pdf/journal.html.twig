<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">

		<style>
			{{css|raw}}</style>
	</head>

	<body>

		{% include 'document_exercice/pdf/_entete.html.twig' %}

		<h1>Journal des opérations</h1>

		<table>

			<thead>
				<tr>
					<th>Date</th>
					<th>Type</th>
					<th>Compte</th>
					<th>Libellé</th>
					<th class="montant">Débit</th>
					<th class="montant">Crédit</th>
				</tr>
			</thead>

			<tbody>

				{% for ligne in lignes %}
					<tr>
						<td>
							{{ ligne.date|date('d/m/Y') }}
						</td>

						<td>
							{{ ligne.type }}
						</td>

						<td>
							{{ ligne.compte }}
						</td>

						<td>
							{{ ligne.libelle }}
						</td>

						<td class="montant">
							{% if ligne.debit != 0 %}
								{{ ligne.debit|number_format(2, ',', ' ') }}
							{% endif %}
						</td>

						<td class="montant">
							{% if ligne.credit != 0 %}
								{{ ligne.credit|number_format(2, ',', ' ') }}
							{% endif %}
						</td>
					</tr>
				{% endfor %}

			</tbody>

			<tfoot>
				<tr>
					<td colspan="4">
						Totaux
					</td>

					<td class="montant">
						{{ totalDebit|number_format(2, ',', ' ') }}
					</td>

					<td class="montant">
						{{ totalCredit|number_format(2, ',', ' ') }}
					</td>
				</tr>
			</tfoot>

		</table>

		<footer class="pdf-footer">
			Document édité le
			{{ "now"|date("d/m/Y") }}
		</footer>

	</body>

</html>
