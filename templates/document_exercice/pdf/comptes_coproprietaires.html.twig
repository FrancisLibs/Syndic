<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">

		<style>
			{{css|raw}}</style>
	</head>

	<body>

		{% include 'document_exercice/pdf/_entete.html.twig' %}

		<h1>Comptes des copropriétaires</h1>

		{% for ligne in comptesCoproprietaires %}

			<section class="compte-coproprietaire">

				<div class="compte-coproprietaire-entete">

					<span class="compte-coproprietaire-nom">
						{{ ligne.coproprietaire }}
					</span>

					<span class="compte-coproprietaire-numero">
						Compte
						{{ ligne.compte.numero }}
					</span>

				</div>

				<table>

					<thead>
						<tr>
							<th>Date</th>
							<th>Pièce</th>
							<th>Libellé</th>
							<th class="montant">Débit</th>
							<th class="montant">Crédit</th>
							<th class="montant">Solde</th>
						</tr>
					</thead>

					<tbody>

						{% for mvt in ligne.mouvements %}

							<tr>
								<td>
									{{ mvt.date|date('d/m/Y') }}
								</td>

								<td>
									{{ mvt.piece }}
								</td>

								<td>
									{{ mvt.libelle }}
								</td>

								<td class="montant">
									{% if mvt.debit != 0 %}
										{{ mvt.debit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="montant">
									{% if mvt.credit != 0 %}
										{{ mvt.credit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="montant">
									{{ mvt.solde|number_format(2, ',', ' ') }}
								</td>
							</tr>

						{% else %}

							<tr>
								<td colspan="6">
									Aucun mouvement sur cet exercice
								</td>
							</tr>

						{% endfor %}

					</tbody>

					<tfoot>
						<tr>
							<td colspan="3">
								Totaux
							</td>

							<td class="montant">
								{{ ligne.totalDebit|number_format(2, ',', ' ') }}
							</td>

							<td class="montant">
								{{ ligne.totalCredit|number_format(2, ',', ' ') }}
							</td>

							<td class="montant">
								{{ ligne.solde|number_format(2, ',', ' ') }}
							</td>
						</tr>
					</tfoot>

				</table>

			</section>

		{% endfor %}

		<footer class="pdf-footer">
			Document édité le
			{{ "now"|date("d/m/Y") }}
		</footer>

	</body>
</html>
