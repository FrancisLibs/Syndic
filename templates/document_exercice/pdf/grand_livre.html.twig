<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">

		<style>
			{{css|raw}}</style>
	</head>

	<body>

		{% include 'document_exercice/pdf/_entete.html.twig' %}

		<h1>Grand livre</h1>

		{% for ligne in grandLivre %}

			<section class="grand-livre-compte">

				<div class="grand-livre-entete-compte">
					<span class="grand-livre-numero">
						{{ ligne.compte.numero }}
					</span>

					<span class="grand-livre-libelle">
						{{ ligne.compte.libelle }}
					</span>

					<span class="grand-livre-solde">
						Solde :
						{{ ligne.solde|number_format(2, ',', ' ') }}
					</span>
				</div>

				<table class="grand-livre-table">

					<thead>
						<tr>
							<th>Date</th>
							<th>Libellé</th>
							<th class="montant">Débit</th>
							<th class="montant">Crédit</th>
							<th class="montant">Solde</th>
						</tr>
					</thead>

					<tbody>
						{% for mvt in ligne.mouvements %}
							<tr>
								<td>
									{{ mvt.date|date('d/m/Y') }}
								</td>

								<td>
									{{ mvt.libelle }}
								</td>

								<td class="montant">
									{% if mvt.debit != 0 %}
										{{ mvt.debit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="montant">
									{% if mvt.credit != 0 %}
										{{ mvt.credit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="montant">
									{{ mvt.solde|number_format(2, ',', ' ') }}
								</td>
							</tr>
						{% endfor %}
					</tbody>

					<tfoot>
						<tr>
							<td colspan="2">
								Totaux
							</td>

							<td class="montant">
								{{ ligne.totalDebit|number_format(2, ',', ' ') }}
							</td>

							<td class="montant">
								{{ ligne.totalCredit|number_format(2, ',', ' ') }}
							</td>

							<td class="montant">
								{{ ligne.solde|number_format(2, ',', ' ') }}
							</td>
						</tr>
					</tfoot>

				</table>

			</section>

		{% endfor %}

		<footer class="pdf-footer">
			Document édité le
			{{ "now"|date("d/m/Y") }}
		</footer>

	</body>

</html>
