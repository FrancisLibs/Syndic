{% extends 'base.html.twig' %}

{% block title %}
    Balance générale - {{ exercice.nom }}
{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Balance générale</h1>

                <p class="text-muted">
                    {{ exercice.nom }}
                    —
                    {{ exercice.dateDebut|date('d/m/Y') }}
                    au
                    {{ exercice.dateFin|date('d/m/Y') }}
                </p>
            </div>

            <a
                href="{{ path('app_document_exercice_index') }}"
                class="btn btn-outline-secondary"
            >
                Retour
            </a>
        </div>

        <div class="alert alert-info">
            La balance de l'exercice sera affichée ici.
        </div>

    </div>
{% endblock %}