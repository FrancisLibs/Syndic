{% extends 'base.html.twig' %}

{% block title %}
	Validation des répartitions
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
		<h1>Validation des répartitions</h1>
		<h2>{{ exercice.nom }}</h2>
	</div>

	<div class="card mb-4">
		<div class="card-header d-flex justify-content-between align-items-center">
			<strong>État de la validation</strong>

			{% if validationGlobale %}
				<span class="badge text-bg-success">
					VALIDÉ
				</span>
			{% else %}
				<span class="badge text-bg-danger">
					À CORRIGER
				</span>
			{% endif %}
		</div>

		<div class="card-body">
			<div class="row g-3">

				<div class="col-md-6 col-lg-3">
					{% if chargesPresentes %}
						<div class="alert alert-success mb-0 h-100">
							<strong>Charges comptabilisées</strong>
							<div>
								Présentes
							</div>
						</div>
					{% else %}
						<div class="alert alert-warning mb-0 h-100">
							<strong>Charges comptabilisées</strong>
							<div>
								Aucune charge
							</div>
						</div>
					{% endif %}
				</div>

				<div class="col-md-6 col-lg-3">
					{% if repartitionEquilibree %}
						<div class="alert alert-success mb-0 h-100">
							<strong>Répartition générale</strong>
							<div>
								Équilibrée
							</div>
						</div>
					{% else %}
						<div class="alert alert-danger mb-0 h-100">
							<strong>Répartition générale</strong>
							<div>
								Écart de
								{{ ecart|number_format(2, ',', ' ') }}
								€
							</div>
						</div>
					{% endif %}
				</div>

				<div class="col-md-6 col-lg-3">
					{% if toutesChargesEquilibrees %}
						<div class="alert alert-success mb-0 h-100">
							<strong>Contrôle par charge</strong>
							<div>
								Toutes conformes
							</div>
						</div>
					{% else %}
						<div class="alert alert-danger mb-0 h-100">
							<strong>Contrôle par charge</strong>
							<div>
								Anomalie détectée
							</div>
						</div>
					{% endif %}
				</div>

				<div class="col-md-6 col-lg-3">
					{% if eauPresente %}
						{% if eauEquilibree %}
							<div class="alert alert-success mb-0 h-100">
								<strong>Répartition de l’eau</strong>
								<div>
									Conforme
								</div>
							</div>
						{% else %}
							<div class="alert alert-danger mb-0 h-100">
								<strong>Répartition de l’eau</strong>
								<div>
									Anomalie détectée
								</div>
							</div>
						{% endif %}
					{% else %}
						<div class="alert alert-secondary mb-0 h-100">
							<strong>Répartition de l’eau</strong>
							<div>
								Non concernée
							</div>
						</div>
					{% endif %}
				</div>

			</div>
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header">
			<strong>Contrôle général</strong>
		</div>

		<div class="card-body">
			<table class="table table-sm mb-3">
				<tbody>
					<tr>
						<th>Charges comptabilisées</th>
						<td class="text-end">
							{{ totalCharges|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>Charges réparties</th>
						<td class="text-end">
							{{ totalReparti|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>Écart</th>
						<td class="text-end">
							{{ ecart|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>
				</tbody>
			</table>

			{% if repartitionEquilibree %}
				<div class="alert alert-success mb-0">
					Les répartitions sont équilibrées.
				</div>
			{% else %}
				<div class="alert alert-danger mb-0">
					Les répartitions présentent un écart de
					{{ ecart|number_format(2, ',', ' ') }}
					€.
				</div>
			{% endif %}
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header">
			<strong>Contrôle par charge</strong>
		</div>

		<div class="card-body p-0">
			{% if controlesCharges is empty %}
				<div class="alert alert-warning m-3">
					Aucune charge comptabilisée n’a été trouvée.
				</div>
			{% else %}
				<div class="table-responsive">
					<table class="table table-striped table-hover mb-0">
						<thead>
							<tr>
								<th>Nature</th>
								<th>Détail</th>
								<th class="text-end">
									Comptabilisé
								</th>
								<th class="text-end">
									Réparti
								</th>
								<th class="text-end">
									Écart
								</th>
								<th class="text-center">
									État
								</th>
							</tr>
						</thead>

						<tbody>
							{% for controle in controlesCharges %}
								<tr class="{{ controle.equilibree ? '' : 'table-danger' }}">

									<td>
										{{ controle.nature }}
									</td>

									<td>
										{{ controle.detail }}
									</td>

									<td class="text-end">
										{{ controle.montantComptabilise
                                        |number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-end">
										{{ controle.montantReparti
                                        |number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-end">
										{{ controle.ecart
                                        |number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-center">
										{% if controle.equilibree %}
											<span class="badge text-bg-success">
												Conforme
											</span>
										{% else %}
											<span class="badge text-bg-danger">
												Anomalie
											</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</div>
	</div>

	{% if groupes is empty %}
		<div class="alert alert-warning">
			Aucune répartition trouvée pour cet exercice.
		</div>
	{% else %}
		{% for groupe in groupes %}
			<div class="card mb-4">
				<div class="card-header">
					<strong>{{ groupe.coproprietaire }}</strong>
				</div>

				<div class="card-body p-0">
					<table class="table table-striped table-hover mb-0">
						<thead>
							<tr>
								<th>Lot</th>
								<th>Nature de charge</th>
								<th>Détail</th>
								<th class="text-end">Tantièmes</th>
								<th class="text-end">Montant</th>
							</tr>
						</thead>

						<tbody>
							{% for ligne in groupe.lignes %}
								<tr>
									<td>
										{{ ligne.lot.reference }}
									</td>

									<td>
										{{ ligne.nature }}
									</td>

									<td>
										{{ ligne.detail }}
									</td>

									<td class="text-end">
										{{ ligne.tantiemes }}
									</td>

									<td class="text-end">
										{{ ligne.montant|number_format(2, ',', ' ') }}
										€
									</td>
								</tr>
							{% endfor %}
						</tbody>

						<tfoot>
							<tr class="table-secondary">
								<th colspan="4" class="text-end">
									Total copropriétaire
								</th>

								<th class="text-end">
									{{ groupe.total|number_format(2, ',', ' ') }}
									€
								</th>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		{% endfor %}
	{% endif %}
{% endblock %}
