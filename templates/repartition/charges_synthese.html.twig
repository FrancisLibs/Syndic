{% extends 'base.html.twig' %}

{% block title %}
	Synthèse des charges
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1 class="mb-0">
				Synthèse des charges
			</h1>

			<p class="text-muted mb-0">
				Exercice :
				<strong>{{ exercice.nom }}</strong>
			</p>
		</div>

		<a href="{{ path('app_repartition_charges') }}" class="btn btn-outline-secondary">
			Voir le détail
		</a>

	</div>


	{% if groupes is empty %}

		<div class="alert alert-info">
			Aucune répartition de charges pour cet exercice.
		</div>

	{% else %}

		{# ================================================= #}
		{# Synthèse générale                                 #}
		{# ================================================= #}

			<div class="card shadow-sm mb-5"> <div class="card-header">
				<strong>Synthèse générale</strong>
			</div>

			<div class="card-body p-0">

				<table class="table table-hover mb-0">

					<thead class="table-light">
						<tr>
							<th>Poste de charge</th>
							<th class="text-end">
								Montant
							</th>
						</tr>
					</thead>

					<tbody>

						{% for clePoste, nomPoste in postes %}

							<tr>

								<td>
									{{ nomPoste }}
								</td>

								<td class="text-end text-nowrap">
									{{ totauxPostes[clePoste]
										|number_format(2, ',', ' ')
									}}
									€
								</td>

							</tr>

						{% endfor %}

					</tbody>

					<tfoot class="table-light">

						<tr>

							<th>
								Total des charges
							</th>

							<th class="text-end text-nowrap">
								{{ totalGeneral
									|number_format(2, ',', ' ')
								}}
								€
							</th>

						</tr>

					</tfoot>

				</table>

			</div>

		</div>


		{# ================================================= #}
		{# Synthèse par copropriétaire                       #}
		{# ================================================= #}

			<div class="mb-3"> <h2>
				Répartition par copropriétaire
			</h2>

		</div>


		<div class="row">

			{% for groupe in groupes %}

				<div class="col-lg-6 mb-4">

					<div class="card shadow-sm h-100">

						<div class="card-header">

							<strong>
								{{ groupe.coproprietaire }}
							</strong>

						</div>

						<div class="card-body p-0">

							<table class="table table-hover mb-0">

								<tbody>

									{% for clePoste, nomPoste in postes %}

										{% set montant =
											groupe.postes[clePoste]
											?? 0
										%}

										{% if montant != 0 %}

											<tr>

												<td>
													{{ nomPoste }}
												</td>

												<td class="text-end text-nowrap">

													{{ montant
														|number_format(
															2,
															',',
															' '
														)
													}}
													€

												</td>

											</tr>

										{% endif %}

									{% endfor %}

								</tbody>

								<tfoot class="table-light">

									<tr>

										<th>
											Total
										</th>

										<th class="text-end text-nowrap">

											{{ groupe.total
												|number_format(
													2,
													',',
													' '
												)
											}}
											€

										</th>

									</tr>

								</tfoot>

							</table>

						</div>

					</div>

				</div>

			{% endfor %}

		</div>

	{% endif %}

{% endblock %}
