{% extends 'base.html.twig' %}

{% block title %}
	Compteur général
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1 class="mb-0">
				Compteur général
			</h1>

			<p class="text-muted mb-0">
				Compteur principal d'eau froide de la copropriété
			</p>
		</div>

	</div>

	<div class="card shadow-sm">

		<div class="card-body">

			{{ form_start(form) }}

				<div class="row">

					<div class="col-md-6">
						{{ form_row(form.reference) }}
					</div>

					<div class="col-md-6">
						{{ form_row(form.indexInitial) }}
					</div>

				</div>

				<div class="mt-4">

					<button
						type="submit"
						class="btn btn-primary"
					>
						Enregistrer
					</button>

				</div>

			{{ form_end(form) }}

		</div>

	</div>

{% endblock %}