<div class="ligne-budget border rounded p-3 mb-3 bg-light">

	<div class="row g-3 align-items-end">

		<div class="col-md-7">

			{{ form_label(ligne.typeCharge) }}

			{{ form_widget(
                ligne.typeCharge,
                {
                    attr: {
                        class: 'form-select'
                    }
                }
            ) }}

		</div>

		<div class="col-md-3">

			{{ form_label(ligne.montant) }}

			<div class="input-group">

				{{ form_widget(
                    ligne.montant,
                    {
                        attr: {
                            class: 'form-control text-end'
                        }
                    }
                ) }}

				<span class="input-group-text">
					€
				</span>

			</div>

		</div>

		<div class="col-md-2 d-grid">

			<button type="button" class="btn btn-danger remove-ligne">

				Supprimer

			</button>

		</div>

	</div>

</div>
