{{ form_start(form) }}

<div class="card shadow-sm mb-4">
	<div class="card-header bg-primary text-white">
		Informations générales
	</div>
	<div class="card-body">
		<div class="row g-3">
			<div class="col-md-4">
				{{ form_label(form.libelle) }}
				{{ form_widget(
                    form.libelle,
                    {
                        attr: {
                            class: 'form-control'
                        }
                    }
                ) }}
				{{ form_errors(form.libelle) }}

			</div>

			<div class="col-md-4">

				{{ form_label(form.copropriete) }}

				{{ form_widget(
                    form.copropriete,
                    {
                        attr: {
                            class: 'form-select'
                        }
                    }
                ) }}

				{{ form_errors(form.copropriete) }}

			</div>

			<div class="col-md-4">

				{{ form_label(form.exercice) }}

				{{ form_widget(
                    form.exercice,
                    {
                        attr: {
                            class: 'form-select'
                        }
                    }
                ) }}

				{{ form_errors(form.exercice) }}

			</div>

		</div>

	</div>

</div>

<div class="card shadow-sm">

	<div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

		<span>
			Lignes budget
		</span>

		<button type="button" class="btn btn-sm btn-light" id="add-ligne">

			+ Ajouter

		</button>

	</div>

	<div class="card-body" id="lignes-budget" data-prototype="{{ include( 'budget/_prototype_ligne.html.twig', { ligne: form.lignes.vars.prototype } )|e('html_attr') }}">

		{% for ligne in form.lignes %}

			<div class="ligne-budget border rounded p-3 mb-3 bg-light">

				<div class="row g-3 align-items-end">

					<div class="col-md-7">

						{{ form_label(ligne.typeCharge) }}

						{{ form_widget(
                            ligne.typeCharge,
                            {
                                attr: {
                                    class: 'form-select'
                                }
                            }
                        ) }}

						{{ form_errors(ligne.typeCharge) }}

					</div>

					<div class="col-md-3">

						{{ form_label(ligne.montant) }}

						<div class="input-group">

							{{ form_widget(
                                ligne.montant,
                                {
                                    attr: {
                                        class: 'form-control text-end'
                                    }
                                }
                            ) }}

							<span class="input-group-text">
								€
							</span>

						</div>

						{{ form_errors(ligne.montant) }}

					</div>

					<div class="col-md-2 d-grid">

						<button type="button" class="btn btn-danger remove-ligne">

							Supprimer

						</button>

					</div>

				</div>

			</div>

		{% endfor %}

	</div>

</div>

<div class="mt-4 d-flex justify-content-end">

	<button class="btn btn-primary btn-lg">

		Enregistrer le budget

	</button>

</div>

{{ form_end(form) }}
