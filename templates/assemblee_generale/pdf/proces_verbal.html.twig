<!DOCTYPE html>

<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <style>
            {{ css|raw }}
        </style>
    </head>

    <body class="proces-verbal-pdf">

        <h1>Procès-verbal de l'Assemblée Générale</h1>

        <h2>
            {{ assemblee_generale.exercice.nom }}
        </h2>

        <p>
            <strong>Date :</strong>
            {{ assemblee_generale.date|date('d/m/Y') }}
        </p>

        <p>
            <strong>Heure :</strong>
            {{ assemblee_generale.heure|date('H:i') }}
        </p>

        <p>
            <strong>Lieu :</strong>
            {{ assemblee_generale.lieu }}
        </p>

        <h2>Constitution du bureau</h2>

        <table>
            <tbody>
                <tr>
                    <th>Président de séance</th>
                    <td>
                        {{ assemblee_generale.presidentSeance ?: 'Non renseigné' }}
                    </td>
                </tr>

                <tr>
                    <th>Scrutateur</th>
                    <td>
                        {{ assemblee_generale.scrutateur ?: 'Non renseigné' }}
                    </td>
                </tr>

                <tr>
                    <th>Secrétaire de séance</th>
                    <td>
                        {{ assemblee_generale.secretaireSeance ?: 'Non renseigné' }}
                    </td>
                </tr>
            </tbody>
        </table>

        <h2>Présence à l'Assemblée Générale</h2>

        <table>
            <thead>
                <tr>
                    <th>Copropriétaire</th>
                    <th>Statut</th>
                    <th>Mandataire</th>
                    <th>Voix</th>
                </tr>
            </thead>

            <tbody>
                {% for presence in assemblee_generale.presences %}
                    <tr>
                        <td>{{ presence.coproprietaire }}</td>

                        <td>
                            {{ presence.statut.label }}
                        </td>

                        <td>
                            {{ presence.mandataire ?: '—' }}
                        </td>

                        <td class="montant">
                            {{ presence.nombreVoix }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3>Récapitulatif de la participation</h3>

        <table>
            <thead>
                <tr>
                    <th>Situation</th>
                    <th>Copropriétaires</th>
                    <th>Voix</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Présents</td>
                    <td>{{ participation.presents.nombre }}</td>
                    <td class="montant">{{ participation.presents.voix }}</td>
                </tr>

                <tr>
                    <td>Représentés</td>
                    <td>{{ participation.representes.nombre }}</td>
                    <td class="montant">{{ participation.representes.voix }}</td>
                </tr>

                <tr>
                    <td>Votes par correspondance</td>
                    <td>{{ participation.correspondance.nombre }}</td>
                    <td class="montant">{{ participation.correspondance.voix }}</td>
                </tr>

                <tr>
                    <td>Absents</td>
                    <td>{{ participation.absents.nombre }}</td>
                    <td class="montant">{{ participation.absents.voix }}</td>
                </tr>
            </tbody>
        </table>

        <h2>Résolutions</h2>

        {% for resolution in assemblee_generale.resolutions %}

            <div class="resolution">

                <h3>
                    Résolution n° {{ resolution.numero }}
                    — {{ resolution.titre }}
                </h3>

                {% if resolution.amendeeEnSeance %}
                    <p>
                        <strong>Résolution amendée en séance</strong>
                    </p>
                {% endif %}

                <p>
                    {{ resolution.texte }}
                </p>

                {% if resolution.decision %}
                    <p>
                        <strong>Décision de l'Assemblée Générale :</strong>
                    </p>

                    <div class="decision-resolution">
                        {{ resolution.decision|nl2br }}
                    </div>
                {% endif %}

                <p>
                    <strong>Majorité :</strong>
                    {{ resolution.majorite ? resolution.majorite.label : 'Aucune' }}
                </p>

                {% if resolution.adoptee is null %}

                    <p>
                        <strong>Résultat :</strong>
                        Non votée
                    </p>

                {% elseif resolution.hasSecondVoteEnregistre %}

                    <p>
                        <strong>Premier vote :</strong>
                        {{ resolution.tantiemesPour ?? 0 }} pour —
                        {{ resolution.tantiemesContre ?? 0 }} contre —
                        {{ resolution.tantiemesAbstention ?? 0 }} abstention
                    </p>

                    <p>
                        <strong>Second vote :</strong>
                        {{ resolution.tantiemesPourSecondTour ?? 0 }} pour —
                        {{ resolution.tantiemesContreSecondTour ?? 0 }} contre —
                        {{ resolution.tantiemesAbstentionSecondTour ?? 0 }} abstention
                    </p>

                    <p>
                        <strong>Résultat :</strong>
                        {% if resolution.adoptee %}
                            Adoptée au second vote
                        {% else %}
                            Rejetée au second vote
                        {% endif %}
                    </p>

                {% else %}

                    <p>
                        <strong>Vote :</strong>
                        {{ resolution.tantiemesPour ?? 0 }} pour —
                        {{ resolution.tantiemesContre ?? 0 }} contre —
                        {{ resolution.tantiemesAbstention ?? 0 }} abstention
                    </p>

                    <p>
                        <strong>Résultat :</strong>
                        {% if resolution.adoptee %}
                            Adoptée
                        {% else %}
                            Rejetée
                        {% endif %}
                    </p>

                {% endif %}

                {# Défaillants en cas d'amendement de la résolution #}
                {% set defaillants =
                    defaillants_amendements[resolution.id] ?? []
                %}

                {% if defaillants is not empty %}
                    <div class="defaillants-amendement">
                        <p>
                            <strong>
                                Vote par correspondance – résolution amendée en séance
                            </strong>
                        </p>

                        <p>
                            Les copropriétaires suivants, ayant voté favorablement
                            par correspondance sur le projet de résolution initial,
                            sont assimilés à des copropriétaires défaillants pour
                            cette résolution :
                        </p>

                        <ul>
                            {% for defaillant in defaillants %}
                                <li>
                                    {{ defaillant.coproprietaire }}
                                    — {{ defaillant.nombreVoix }} voix
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

            </div>

        {% endfor %}

        <div class="cloture-pv">

            <h2>Clôture de l'Assemblée Générale</h2>

            <p>
                L'ordre du jour étant épuisé, la séance est levée
                {% if assemblee_generale.heureCloture %}
                    à {{ assemblee_generale.heureCloture|date('H\\hi') }}.
                {% else %}
                    à ____ h ____.
                {% endif %}
            </p>

            <p>
                Le présent procès-verbal est établi à l'issue de l'Assemblée Générale.
            </p>

            <table class="signatures-pv">
                <tr>
                    <td>
                        <strong>Le président de séance</strong>
                        <br><br><br><br>
                        {{ assemblee_generale.presidentSeance ?: '____________________' }}
                    </td>

                    <td>
                        <strong>Le scrutateur</strong>
                        <br><br><br><br>
                        {{ assemblee_generale.scrutateur ?: '____________________' }}
                    </td>

                    <td>
                        <strong>Le secrétaire de séance</strong>
                        <br><br><br><br>
                        {{ assemblee_generale.secretaireSeance ?: '____________________' }}
                    </td>
                </tr>
            </table>

        </div>

    </body>
</html>
