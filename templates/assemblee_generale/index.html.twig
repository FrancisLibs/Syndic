{% extends 'base.html.twig' %}

{% block title %}
    Assemblées Générales
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Assemblées Générales</h1>

        <a
            href="{{ path('app_assemblee_generale_new') }}"
            class="btn btn-success"
        >
            Nouvelle Assemblée Générale
        </a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Exercice</th>
                <th class="text-center">Date</th>
                <th class="text-center">Heure</th>
                <th>Lieu</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>

            {% for assemblee_generale in assemblee_generales %}

                <tr>
                    <td>
                        {{ assemblee_generale.exercice.nom }}
                    </td>

                    <td class="text-center">
                        {{ assemblee_generale.date
                            ? assemblee_generale.date|date('d/m/Y')
                            : ''
                        }}
                    </td>

                    <td class="text-center">
                        {{ assemblee_generale.heure
                            ? assemblee_generale.heure|date('H:i')
                            : ''
                        }}
                    </td>

                    <td>
                        {{ assemblee_generale.lieu }}
                    </td>

                    <td class="text-center">

                        <a
                            href="{{ path(
                                'app_assemblee_generale_show',
                                {'id': assemblee_generale.id}
                            ) }}"
                            class="btn btn-sm btn-primary"
                        >
                            Préparer l'AG
                        </a>

                        <a
                            href="{{ path(
                                'app_assemblee_generale_edit',
                                {'id': assemblee_generale.id}
                            ) }}"
                            class="btn btn-sm btn-outline-secondary"
                        >
                            Modifier
                        </a>

                    </td>
                </tr>

            {% else %}

                <tr>
                    <td colspan="5" class="text-center">
                        Aucune Assemblée Générale enregistrée.
                    </td>
                </tr>

            {% endfor %}

        </tbody>
    </table>

{% endblock %}
