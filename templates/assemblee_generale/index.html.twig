{% extends 'base.html.twig' %}

{% block title %}
    Assemblées Générales
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Assemblées Générales</h1>

        <a
            href="{{ path('app_assemblee_generale_new') }}"
            class="btn btn-success"
        >
            Nouvelle Assemblée Générale
        </a>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>N°</th>
                <th>Exercice</th>
                <th class="text-center">Date</th>
                <th class="text-center">Heure</th>
                <th>Lieu</th>
                <th class="text-center">Statut</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>

            {% for assemblee_generale in assemblee_generales %}

                {% set estCloturee = assemblee_generale.statut.value == 'cloturee' %}

                <tr>
                    <td>
                        {{ assemblee_generale.id }}
                    </td>

                    <td>
                        {{ assemblee_generale.exercice.nom }}
                    </td>

                    <td class="text-center">
                        {{ assemblee_generale.date
                            ? assemblee_generale.date|date('d/m/Y')
                            : '—'
                        }}
                    </td>

                    <td class="text-center">
                        {{ assemblee_generale.heure
                            ? assemblee_generale.heure|date('H:i')
                            : '—'
                        }}
                    </td>

                    <td>
                        {{ assemblee_generale.lieu ?: '—' }}
                    </td>

                    <td class="text-center">
                        {% if estCloturee %}
                            <span class="badge bg-secondary">
                                Clôturée
                            </span>
                        {% else %}
                            <span class="badge bg-warning text-dark">
                                En préparation
                            </span>
                        {% endif %}
                    </td>

                    <td class="text-center">

                        <a
                            href="{{ path(
                                'app_assemblee_generale_show',
                                {'id': assemblee_generale.id}
                            ) }}"
                            class="btn btn-sm {{ estCloturee ? 'btn-outline-primary' : 'btn-primary' }}"
                        >
                            {{ estCloturee ? 'Consulter' : "Préparer l'AG" }}
                        </a>

                        {% if not estCloturee %}
                            <a
                                href="{{ path(
                                    'app_assemblee_generale_edit',
                                    {'id': assemblee_generale.id}
                                ) }}"
                                class="btn btn-sm btn-outline-secondary"
                            >
                                Modifier
                            </a>
                        {% endif %}

                    </td>
                </tr>

            {% else %}

                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        Aucune Assemblée Générale enregistrée.
                    </td>
                </tr>

            {% endfor %}

        </tbody>
    </table>

{% endblock %}
