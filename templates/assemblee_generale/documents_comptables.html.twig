{% extends 'base.html.twig' %}

{% block title %}
    Documents comptables de l'AG
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Documents comptables</h1>
            <h2>Assemblée Générale — {{ exercice.nom }}</h2>
        </div>

    </div>

    <div class="alert alert-info">
        Ces documents concernent l'exercice
        <strong>{{ exercice.nom }}</strong>
        soumis à l'approbation de l'Assemblée Générale.
    </div>


    <div class="card mb-4">

        <div class="card-header">
            <strong>Comptes de l'exercice</strong>
        </div>

        <div class="list-group list-group-flush">

            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <strong>Balance générale</strong>

                    <div class="text-muted small">
                        Situation de l'ensemble des comptes de l'exercice.
                    </div>
                </div>

                <a
                    href="{{ path(
                        'app_document_exercice_balance_pdf'
                    ) }}"
                    class="btn btn-primary"
                    target="_blank"
                >
                    PDF
                </a>

            </div>


            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <strong>Comptes des copropriétaires</strong>

                    <div class="text-muted small">
                        Relevés individuels des copropriétaires.
                    </div>
                </div>

                <a
                    href="{{ path(
                        'app_document_exercice_comptes_coproprietaires_pdf'
                    ) }}"
                    class="btn btn-primary"
                    target="_blank"
                >
                    PDF
                </a>

            </div>


            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <strong>Répartition des charges</strong>

                    <div class="text-muted small">
                        Répartition des dépenses entre les copropriétaires.
                    </div>
                </div>

                <a
                    href="{{ path(
                        'app_document_exercice_repartition_charges_pdf'
                    ) }}"
                    class="btn btn-primary"
                    target="_blank"
                >
                    PDF
                </a>

            </div>


            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div>
                    <strong>Répartition de l'eau</strong>

                    <div class="text-muted small">
                        Consommations et répartition des dépenses d'eau.
                    </div>
                </div>

                <a
                    href="{{ path(
                        'app_document_exercice_repartition_eau_pdf'
                    ) }}"
                    class="btn btn-primary"
                    target="_blank"
                >
                    PDF
                </a>

            </div>

        </div>

    </div>


    <div class="mt-4">

        <a
            href="{{ path(
                'app_assemblee_generale_show',
                {'id': assemblee_generale.id}
            ) }}"
            class="btn btn-secondary"
        >
            Retour à l'Assemblée Générale
        </a>

    </div>

{% endblock %}
