{% extends 'base.html.twig' %}

{% block title %}
    Soldes reportables
{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1>Soldes reportables</h1>

    <p class="text-muted">
        Exercice {{ exercice.nom }}
    </p>

    <a
        href="{{ path('app_cloture_workflow', { id: exercice.id }) }}"
        class="btn btn-outline-secondary mb-3"
    >
        ← Retour à l'assistant
    </a>

    {% set totalDebit = 0 %}
    {% set totalCredit = 0 %}

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Compte</th>
                <th>Libellé</th>
                <th>Copropriétaire</th>
                <th class="text-end">Débit</th>
                <th class="text-end">Crédit</th>
            </tr>
        </thead>

        <tbody>
            {% for solde in soldes %}
                {% set totalDebit = totalDebit + solde.debit %}
                {% set totalCredit = totalCredit + solde.credit %}

                <tr>
                    <td>{{ solde.compte.numero }}</td>
                    <td>{{ solde.compte.libelle }}</td>
                    <td>
                        {{ solde.coproprietaire ? solde.coproprietaire : '-' }}
                    </td>
                    <td class="text-end">
                        {{ solde.debit > 0 ? solde.debit|number_format(2, ',', ' ') ~ ' €' : '-' }}
                    </td>
                    <td class="text-end">
                        {{ solde.credit > 0 ? solde.credit|number_format(2, ',', ' ') ~ ' €' : '-' }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        Aucun solde reportable.
                    </td>
                </tr>
            {% endfor %}
        </tbody>

        <tfoot>
            <tr>
                <th colspan="3" class="text-end">
                    Totaux
                </th>
                <th class="text-end">
                    {{ totalDebit|number_format(2, ',', ' ') }} €
                </th>
                <th class="text-end">
                    {{ totalCredit|number_format(2, ',', ' ') }} €
                </th>
            </tr>
        </tfoot>
    </table>

</div>

{% endblock %}