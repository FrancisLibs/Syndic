{% extends 'base.html.twig' %}

{% block title %}
	À-nouveaux
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1>À-nouveaux</h1>

		<p class="text-muted">
			Exercice
			{{ exercice.nom }}
		</p>

		<a href="{{ path('app_cloture_workflow', { id: exercice.id }) }}" class="btn btn-outline-secondary mb-3">
			← Retour à l'assistant
		</a>

		<div class="alert alert-info">
			Cette page présente les écritures d'à-nouveaux qui seront générées lors de l'ouverture du nouvel exercice.
		</div>

		{% if anouveaux.generes %}

			<div class="alert alert-success">

				<strong>
					✓ Les écritures d'à-nouveaux ont déjà été générées.
				</strong>

				<hr>

				<p class="mb-1">
					<strong>Date :</strong>
					{{ anouveaux.operation.date|date('d/m/Y') }}
				</p>

				<p class="mb-0">
					<strong>Libellé :</strong>
					{{ anouveaux.operation.libelle }}
				</p>

			</div>

		{% endif %}

		<div class="card mb-3">
			<div class="card-body">
				<p class="mb-1">
					<strong>{{ anouveaux.lignes|length }}</strong>
					lignes d'écriture seront générées.
				</p>

				<p class="mb-1">
					Total débit :
					<strong>{{ anouveaux.totalDebit|number_format(2, ',', ' ') }}
						€</strong>
				</p>

				<p class="mb-0">
					Total crédit :
					<strong>{{ anouveaux.totalCredit|number_format(2, ',', ' ') }}
						€</strong>
				</p>
			</div>
		</div>

		<table class="table table-striped table-bordered align-middle">
			<thead>
				<tr>
					<th>Compte</th>
					<th>Libellé</th>
					<th>Copropriétaire</th>
					<th class="text-end">Débit</th>
					<th class="text-end">Crédit</th>
				</tr>
			</thead>

			<tbody>
				{% for solde in anouveaux.lignes %}
					<tr>
						<td>{{ solde.compte.numero }}</td>
						<td>{{ solde.compte.libelle }}</td>
						<td>{{ solde.coproprietaire ? solde.coproprietaire : '-' }}</td>

						<td class="text-end">
							{{ solde.debit > 0 ? solde.debit|number_format(2, ',', ' ') ~ ' €' : '-' }}
						</td>

						<td class="text-end">
							{{ solde.credit > 0 ? solde.credit|number_format(2, ',', ' ') ~ ' €' : '-' }}
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5" class="text-center text-muted">
							Aucun à-nouveau à générer.
						</td>
					</tr>
				{% endfor %}
			</tbody>

			<tfoot>
				<tr class="table-light">
					<th colspan="3" class="text-end">Totaux</th>
					<th class="text-end">{{ anouveaux.totalDebit|number_format(2, ',', ' ') }}
						€</th>
					<th class="text-end">{{ anouveaux.totalCredit|number_format(2, ',', ' ') }}
						€</th>
				</tr>
			</tfoot>
		</table>

		{% if anouveaux.estEquilibre %}
			<div class="alert alert-success">
				✅ Les écritures d'à-nouveaux sont équilibrées.
			</div>
		{% else %}
			<div class="alert alert-danger">
				❌ Les écritures d'à-nouveaux ne sont pas équilibrées.
			</div>
		{% endif %}

	</div>

{% endblock %}
