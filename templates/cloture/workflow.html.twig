{% extends 'base.html.twig' %}

{% block title %}
	Assistant de clôture
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1>Assistant de clôture</h1>

		<h5 class="text-muted">
			Exercice
			{{ exercice.nom }}
		</h5>

		<div class="alert alert-{{ etat.classeBootstrap }} mt-3">
			<strong>{{ etat.message }}</strong>
		</div>

		{% if exercice.isCloture %}

			<div class="alert alert-success shadow-sm">

				<h4 class="alert-heading mb-3">
					✅ Exercice clôturé
				</h4>

				<p class="mb-2">
					L'exercice
					<strong>{{ exercice.nom }}</strong>
					est définitivement clôturé.
				</p>

				{% if etat.exerciceSuivant %}
					<p class="mb-0">
						L'exercice
						<strong>{{ etat.exerciceSuivant.nom }}</strong>
						est désormais l'exercice actif.
					</p>
				{% endif %}

			</div>

			<div class="card mb-3">

				<div class="card-header">
					<strong>Dossier de clôture</strong>
				</div>

				<div class="card-body">

					<p>
						Les documents de contrôle restent disponibles.
					</p>

					<div class="list-group mb-3">

						<a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
							📄 Répartition des charges
						</a>

						<a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
							📄 Soldes reportables
						</a>

						<a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
							📄 Clôture des comptes de gestion
						</a>

						<a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
							📄 À-nouveaux
						</a>

					</div>

					<button class="btn btn-outline-secondary" disabled>
						📕 Dossier complet de clôture PDF
					</button>

					<hr>

					<a href="{{ path('app_assemblee_generale', { id: exercice.id }) }}" class="btn btn-primary">
						Préparer l'Assemblée Générale
					</a>

				</div>

			</div>

		{% else %}

			<hr>

			{# 1. Vérifications #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>1. Vérifications</strong>
				</div>

				<div class="card-body">

					<ul class="list-group list-group-flush">

						<li class="list-group-item">
							{{ etat.exerciceActif ? '✅' : '❌' }}
							Exercice actif
						</li>

						<li class="list-group-item">
							{{ not etat.exerciceCloture ? '✅' : '❌' }}
							Exercice non clôturé
						</li>

						<li class="list-group-item">
							{{ etat.exerciceTermine ? '✅' : '❌' }}
							Date de fin atteinte
						</li>

						<li class="list-group-item">
							{{ etat.budgetsVerrouilles ? '✅' : '❌' }}
							Budgets verrouillés
						</li>

						<li class="list-group-item">
							{{ etat.operationsEquilibrees ? '✅' : '❌' }}
							Opérations équilibrées
						</li>

					</ul>

					{% if etat.estBloque %}

						<div class="alert alert-danger mt-3 mb-0">

							<strong>
								La clôture est bloquée.
							</strong>

							<ul class="mb-0 mt-2">
								{% for erreur in etat.erreurs %}
									<li>{{ erreur }}</li>
								{% endfor %}
							</ul>

						</div>

					{% else %}

						<div class="alert alert-success mt-3 mb-0">
							Les vérifications préalables sont satisfaites.
						</div>

					{% endif %}

				</div>

			</div>

			{# 2. Contrôle des répartitions #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>2. Contrôle des répartitions</strong>
				</div>

				<div class="card-body">

					<p>
						Les charges réparties entre les copropriétaires peuvent être
																		contrôlées avant la clôture.
					</p>

					<p class="text-muted">
						Aucune écriture comptable de régularisation n'est générée
																		à cette étape.
					</p>

					<a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="btn btn-outline-primary">
						Consulter les répartitions
					</a>

				</div>

			</div>

			{# 3. Résultat de l'exercice #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>3. Résultat de l'exercice</strong>
				</div>

				<div class="card-body">

					<table class="table table-sm mb-3">

						<tr>
							<th>Charges</th>

							<td class="text-end">
								{{ resultatExercice.charges|number_format(2, ',', ' ') }}
								€
							</td>
						</tr>

						<tr>
							<th>Produits</th>

							<td class="text-end">
								{{ resultatExercice.produits|number_format(2, ',', ' ') }}
								€
							</td>
						</tr>

						<tr class="table-light">
							<th>Solde en attente de répartition</th>

							<td class="text-end">
								<strong>
									{{ resultatExercice.resultat|number_format(2, ',', ' ') }}
									€
								</strong>
							</td>
						</tr>

					</table>

					{% if resultatExercice.estEquilibre %}

						<div class="alert alert-success mb-0">
							Les charges et les produits sont équilibrés.
						</div>

					{% elseif resultatExercice.estExcedentaire %}

						<div class="alert alert-warning mb-0">
							Excédent de provisions de
							<strong>
								{{ resultatExercice.resultat|number_format(2, ',', ' ') }}
								€
							</strong>.
														
																					Ce montant sera transféré au compte 489000 lors de la
																					clôture des comptes de gestion.
						</div>

					{% else %}

						<div class="alert alert-warning mb-0">
							Insuffisance de provisions de
							<strong>
								{{ (-resultatExercice.resultat)|number_format(2, ',', ' ') }}
								€
							</strong>.
														
																					Ce montant sera transféré au compte 489000 lors de la
																					clôture des comptes de gestion.
						</div>

					{% endif %}

				</div>

			</div>

			{# 4. Clôture des comptes de gestion #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>4. Clôture des comptes de gestion</strong>
				</div>

				<div class="card-body">

					{% if etat.clotureComptesGestionGeneree %}

						<div class="alert alert-success">
							✅ Les comptes de charges et de produits ont été soldés
																					par le compte 489000.
						</div>

						<a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="btn btn-outline-primary">
							Consulter les écritures générées
						</a>

					{% elseif etat.peutGenererClotureComptesGestion() %}

						<div class="alert alert-warning">
							Les écritures de clôture des comptes de gestion ne sont
																					pas encore générées.
						</div>

						<p>
							Cette opération soldera les comptes de classes 6 et 7
																					par le compte 489000.
						</p>

						<a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="btn btn-outline-secondary">
							Afficher le détail
						</a>

						<form method="post" action="{{ path('app_cloture_generer_comptes_gestion', { id: exercice.id }) }}" class="d-inline">
							<button type="submit" class="btn btn-primary" onclick="return confirm('Confirmer la génération des écritures de clôture des comptes de gestion ?')">
								Générer les écritures
							</button>
						</form>

					{% else %}

						<div class="alert alert-secondary mb-0">
							Les écritures de clôture des comptes de gestion ne peuvent
																					pas encore être générées.
						</div>

					{% endif %}

				</div>

			</div>

			{# 5. Exercice suivant #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>5. Exercice suivant</strong>
				</div>

				<div class="card-body">

					{% if etat.exerciceSuivantExiste %}

						<div class="alert alert-success mb-3">
							✅ L'exercice suivant est disponible.
						</div>

						<table class="table table-sm mb-0">

							<tr>
								<th>Exercice</th>
								<td>{{ etat.exerciceSuivant.nom }}</td>
							</tr>

							<tr>
								<th>Période</th>

								<td>
									{{ etat.exerciceSuivant.dateDebut|date('d/m/Y') }}
									→
									{{ etat.exerciceSuivant.dateFin|date('d/m/Y') }}
								</td>
							</tr>

						</table>

					{% elseif etat.peutCreerExerciceSuivant() %}

						<div class="alert alert-warning mb-3">
							Aucun exercice suivant n'existe.
						</div>

						<p>
							La clôture des comptes de gestion est terminée.
																					L'exercice suivant peut maintenant être créé.
						</p>

						<form method="post" action="{{ path('app_cloture_creer_exercice_suivant', { id: exercice.id }) }}" class="d-inline">
							<button type="submit" class="btn btn-primary" onclick="return confirm('Créer l’exercice suivant ?')">
								Créer l'exercice suivant
							</button>
						</form>

					{% else %}

						<div class="alert alert-secondary mb-0">
							L'exercice suivant ne peut pas encore être créé.
						</div>

					{% endif %}

				</div>

			</div>

			{# 6. À-nouveaux #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>6. À-nouveaux</strong>
				</div>

				<div class="card-body">

					{% if etat.anouveauxGeneres %}

						<div class="alert alert-success">
							✅ Les écritures d'à-nouveaux ont été générées dans
																					l'exercice suivant.
						</div>

						<a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="btn btn-outline-primary">
							Consulter les écritures générées
						</a>

						<a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="btn btn-outline-secondary">
							Consulter les soldes reportables
						</a>

					{% elseif etat.peutGenererANouveaux() %}

						<div class="alert alert-warning">
							Les écritures d'à-nouveaux ne sont pas encore générées.
						</div>

						<p>
							Les comptes de bilan, dont le compte 489000, seront
																					repris dans l'exercice suivant.
						</p>

						<a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="btn btn-outline-secondary">
							Afficher le détail
						</a>

						<a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="btn btn-outline-secondary">
							Consulter les soldes reportables
						</a>

						<form method="post" action="{{ path('app_cloture_generer_anouveaux', { id: exercice.id }) }}" class="d-inline">
							<button type="submit" class="btn btn-primary" onclick="return confirm('Confirmer la génération des à-nouveaux ?')">
								Générer les à-nouveaux
							</button>
						</form>

					{% else %}

						<div class="alert alert-secondary">
							Les à-nouveaux ne peuvent pas encore être générés.
						</div>

						<a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="btn btn-outline-secondary">
							Consulter les soldes reportables
						</a>

					{% endif %}

				</div>

			</div>

			{# 7. Clôture définitive #}
			<div class="card mb-3">

				<div class="card-header">
					<strong>7. Clôture définitive</strong>
				</div>

				<div class="card-body">

					{% if etat.peutCloturer() %}

						<div class="alert alert-warning">
							Toutes les étapes techniques sont terminées.
																					L'exercice peut être clôturé.
						</div>

						<p>
							Le solde du compte 489000 restera en attente jusqu'à
																					l'approbation des comptes par l'Assemblée Générale.
						</p>

						<form method="post" action="{{ path('app_cloture_exercice', { id: exercice.id }) }}" class="d-inline">
							<button type="submit" class="btn btn-danger" onclick="return confirm('Confirmer la clôture définitive de l’exercice ?')">
								Clôturer l'exercice
							</button>
						</form>

					{% else %}

						<div class="alert alert-secondary mb-0">
							La clôture définitive n'est pas encore disponible.
						</div>

					{% endif %}

				</div>

			</div>

		{% endif %}

	</div>

{% endblock %}
