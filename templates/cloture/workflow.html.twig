{% extends 'base.html.twig' %}

{% block title %}
    Assistant de clôture
{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1>Assistant de clôture</h1>

    <h5 class="text-muted">
        Exercice {{ exercice.nom }}
    </h5>

    <div class="alert alert-{{ etat.classeBootstrap }} mt-3">
        <strong>{{ etat.message }}</strong>
    </div>

    {% if exercice.isCloture %}

        <div class="alert alert-success shadow-sm">

            <h4 class="alert-heading mb-3">
                ✅ Exercice clôturé
            </h4>

            <p class="mb-2">
                L'exercice
                <strong>{{ exercice.nom }}</strong>
                est définitivement clôturé.
            </p>

            {% if etat.exerciceSuivant %}
                <p class="mb-0">
                    L'exercice
                    <strong>{{ etat.exerciceSuivant.nom }}</strong>
                    est désormais l'exercice actif.
                </p>
            {% endif %}

        </div>

        <div class="card mb-3">

            <div class="card-header">
                <strong>Dossier de clôture</strong>
            </div>

            <div class="card-body">

                <p>
                    Les documents de contrôle restent disponibles.
                </p>

                <div class="list-group mb-3">

                    <a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
                        📄 Régularisations
                    </a>

                    <a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
                        📄 Soldes reportables
                    </a>

                    <a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
                        📄 Clôture des comptes de gestion
                    </a>

                    <a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="list-group-item list-group-item-action">
                        📄 À-nouveaux
                    </a>

                </div>

                <button class="btn btn-outline-secondary" disabled>
                    📕 Dossier complet de clôture PDF
                </button>

            </div>

        </div>

    {% else %}

        <hr>

        {# 1. Vérifications #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>1. Vérifications</strong>
            </div>

            <div class="card-body">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        {{ etat.exerciceActif ? '✅' : '❌' }}
                        Exercice actif
                    </li>

                    <li class="list-group-item">
                        {{ not etat.exerciceCloture ? '✅' : '❌' }}
                        Exercice non clôturé
                    </li>

                    <li class="list-group-item">
                        {{ etat.budgetsVerrouilles ? '✅' : '❌' }}
                        Budgets verrouillés
                    </li>

                    <li class="list-group-item">
                        {{ etat.operationsEquilibrees ? '✅' : '❌' }}
                        Opérations équilibrées
                    </li>

                </ul>

                {% if etat.estBloque %}
                    <div class="alert alert-danger mt-3 mb-0">
                        <strong>La clôture est bloquée.</strong>

                        <ul class="mb-0 mt-2">
                            {% for erreur in etat.erreurs %}
                                <li>{{ erreur }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% else %}
                    <div class="alert alert-success mt-3 mb-0">
                        Les vérifications préalables sont satisfaites.
                    </div>
                {% endif %}

            </div>

        </div>

        {# 2. Régularisations #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>2. Régularisations</strong>
            </div>

            <div class="card-body">

                {% if etat.regularisationsGenerees %}

                    <div class="alert alert-success">
                        ✅ Les régularisations ont été générées.
                    </div>

                    <a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="btn btn-outline-primary">
                        Consulter les régularisations
                    </a>

                {% elseif etat.peutGenererRegularisations %}

                    <div class="alert alert-warning">
                        Les régularisations ne sont pas encore générées.
                    </div>

                    <a href="{{ path('app_cloture_regularisations', { id: exercice.id }) }}" class="btn btn-outline-secondary">
                        Afficher le détail
                    </a>

                    <form method="post" action="{{ path('app_cloture_generer_regularisations', { id: exercice.id }) }}" class="d-inline">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmer la génération des régularisations ?')">
                            Générer les régularisations
                        </button>
                    </form>

                {% else %}

                    <div class="alert alert-secondary mb-0">
                        Les régularisations ne sont pas encore disponibles.
                    </div>

                {% endif %}

            </div>

        </div>

        {# 3. Soldes reportables #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>3. Soldes reportables</strong>
            </div>

            <div class="card-body">

                {% set totalDebit = 0 %}
                {% set totalCredit = 0 %}

                {% for solde in soldes %}
                    {% set totalDebit = totalDebit + solde.debit %}
                    {% set totalCredit = totalCredit + solde.credit %}
                {% endfor %}

                <p>
                    Nombre de comptes à reporter :
                    <strong>{{ soldes|length }}</strong>
                </p>

                <p>
                    Total débit :
                    <strong>{{ totalDebit|number_format(2, ',', ' ') }} €</strong>
                </p>

                <p>
                    Total crédit :
                    <strong>{{ totalCredit|number_format(2, ',', ' ') }} €</strong>
                </p>

                {% if soldes is empty %}
                    <div class="alert alert-secondary mb-0">
                        Aucun solde à reporter.
                    </div>
                {% else %}
                    <a href="{{ path('app_cloture_soldes_reportables', { id: exercice.id }) }}" class="btn btn-outline-primary">
                        Afficher le détail
                    </a>
                {% endif %}

            </div>

        </div>

        {# 4. Résultat #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>4. Résultat de l'exercice</strong>
            </div>

            <div class="card-body">

                <table class="table table-sm mb-3">
                    <tr>
                        <th>Charges</th>
                        <td class="text-end">
                            {{ resultatExercice.charges|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>

                    <tr>
                        <th>Produits</th>
                        <td class="text-end">
                            {{ resultatExercice.produits|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>

                    <tr class="table-light">
                        <th>Résultat</th>
                        <td class="text-end">
                            <strong>{{ resultatExercice.resultat|number_format(2, ',', ' ') }} €</strong>
                        </td>
                    </tr>
                </table>

                {% if resultatExercice.estEquilibre %}
                    <div class="alert alert-success">
                        Le résultat de l'exercice est équilibré.
                    </div>
                {% elseif resultatExercice.estExcedentaire %}
                    <div class="alert alert-warning">
                        Excédent de
                        <strong>{{ resultatExercice.resultat|number_format(2, ',', ' ') }} €</strong>.
                    </div>
                {% else %}
                    <div class="alert alert-warning">
                        Déficit de
                        <strong>{{ (-resultatExercice.resultat)|number_format(2, ',', ' ') }} €</strong>.
                    </div>
                {% endif %}

            </div>

        </div>

        {# 5. Clôture des comptes de gestion #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>5. Clôture des comptes de gestion</strong>
            </div>

            <div class="card-body">

                {% if etat.clotureComptesGestionGeneree %}

                    <div class="alert alert-success">
                        ✅ Les écritures de clôture des comptes de gestion ont été générées.
                    </div>

                    <a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="btn btn-outline-primary">
                        Consulter les écritures générées
                    </a>

                {% elseif etat.peutGenererClotureComptesGestion() %}

                    <div class="alert alert-warning">
                        Les écritures de clôture ne sont pas encore générées.
                    </div>

                    <a href="{{ path('app_cloture_comptes_gestion', { id: exercice.id }) }}" class="btn btn-outline-secondary">
                        Afficher le détail
                    </a>

                    <form method="post" action="{{ path('app_cloture_generer_comptes_gestion', { id: exercice.id }) }}" class="d-inline">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmer la génération des écritures de clôture ?')">
                            Générer les écritures
                        </button>
                    </form>

                {% else %}

                    <div class="alert alert-secondary mb-0">
                        Les écritures de clôture ne sont pas encore disponibles.
                    </div>

                {% endif %}

            </div>

        </div>

        {# 6. Exercice suivant #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>6. Exercice suivant</strong>
            </div>

            <div class="card-body">

                {% if etat.exerciceSuivantExiste %}

                    <div class="alert alert-success mb-3">
                        ✅ L'exercice suivant est disponible.
                    </div>

                    <table class="table table-sm mb-3">
                        <tr>
                            <th>Exercice</th>
                            <td>{{ etat.exerciceSuivant.nom }}</td>
                        </tr>
                        <tr>
                            <th>Période</th>
                            <td>
                                {{ etat.exerciceSuivant.dateDebut|date('d/m/Y') }}
                                →
                                {{ etat.exerciceSuivant.dateFin|date('d/m/Y') }}
                            </td>
                        </tr>
                    </table>

                {% else %}

                    <div class="alert alert-warning mb-3">
                        Aucun exercice suivant n'existe.
                    </div>

                    <p>
                        Les à-nouveaux ne pourront être générés qu'après la création du nouvel exercice.
                    </p>

                    <a href="{{ path('app_exercice_new') }}" class="btn btn-primary">
                        Créer le nouvel exercice
                    </a>

                {% endif %}

            </div>

        </div>

        {# 7. À-nouveaux #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>7. À-nouveaux</strong>
            </div>

            <div class="card-body">

                {% if etat.anouveauxGeneres %}

                    <div class="alert alert-success">
                        ✅ Les écritures d’à-nouveaux ont été générées.
                    </div>

                    <a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="btn btn-outline-primary">
                        Consulter les écritures générées
                    </a>

                {% elseif etat.peutGenererANouveaux() %}

                    <div class="alert alert-warning">
                        Les écritures d’à-nouveaux ne sont pas encore générées.
                    </div>

                    <a href="{{ path('app_cloture_anouveaux', { id: exercice.id }) }}" class="btn btn-outline-secondary">
                        Afficher le détail
                    </a>

                    <form method="post" action="{{ path('app_cloture_generer_anouveaux', { id: exercice.id }) }}" class="d-inline">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmer la génération des à-nouveaux ?')">
                            Générer les à-nouveaux
                        </button>
                    </form>

                {% else %}

                    <div class="alert alert-secondary mb-0">
                        Les à-nouveaux ne sont pas encore disponibles.
                    </div>

                {% endif %}

            </div>

        </div>

        {# 8. Clôture définitive #}
        <div class="card mb-3">

            <div class="card-header">
                <strong>8. Clôture définitive</strong>
            </div>

            <div class="card-body">

                {% if etat.exerciceCloture %}

                    <div class="alert alert-success mb-0">
                        ✅ L'exercice est définitivement clôturé.
                    </div>

                {% elseif etat.peutCloturer() %}

                    <div class="alert alert-warning">
                        Toutes les étapes sont terminées. L'exercice peut être clôturé.
                    </div>

                    <form method="post" action="{{ path('app_cloture_exercice', { id: exercice.id }) }}" class="d-inline">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Confirmer la clôture définitive de l’exercice ?')">
                            Clôturer l'exercice
                        </button>
                    </form>

                {% else %}

                    <div class="alert alert-secondary mb-0">
                        La clôture définitive n'est pas encore disponible.
                    </div>

                {% endif %}

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}