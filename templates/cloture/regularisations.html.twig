{% extends 'base.html.twig' %}

{% block title %}Exercice index
{% endblock %}

{% block body %}
	<div class="container mt-4">

		<h1>Régularisations</h1>

		<p class="text-muted">
			Exercice
			{{ exercice.nom }}
		</p>

		<a href="{{ path('app_cloture_workflow', { id: exercice.id }) }}" class="btn btn-outline-secondary mb-3">
			← Retour à l'assistant
		</a>

		<table class="table">
			<thead>
				<tr>
					<th>Copropriétaire</th>
					<th>Tantièmes</th>
					<th>Appels</th>
					<th>Charges réelles</th>
					<th>Régularisation</th>
				</tr>
			</thead>

			<tbody>
				{% for ligne in regularisations %}
					<tr>
						<td>{{ ligne.coproprietaire }}</td>
						<td>{{ ligne.tantiemes }}</td>
						<td>{{ ligne.totalAppele|number_format(2, ',', ' ') }}
							€</td>
						<td>{{ ligne.quotePartReelle|number_format(2, ',', ' ') }}
							€</td>
						<td>{{ ligne.resultat|number_format(2, ',', ' ') }}
							€</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock %}
