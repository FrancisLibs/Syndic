{% extends 'base.html.twig' %}

{% block title %}
	Régularisations
{% endblock %}

{% block body %}
	<div class="container mt-4">

		<h1>Régularisations</h1>

		<p class="text-muted">
			Exercice
			{{ exercice.nom }}
		</p>

		<a href="{{ path('app_cloture_workflow', { id: exercice.id }) }}" class="btn btn-outline-secondary mb-3">
			← Retour à l'assistant
		</a>

		<table class="table">
			<thead>
				<tr>
					<th>Copropriétaire</th>
					<th class="text-end">Tantièmes</th>
					<th class="text-end">Appels</th>
					<th class="text-end">Charges réelles</th>
					<th class="text-end">Régularisation</th>
				</tr>
			</thead>

			<tbody>
				{% for ligne in simulation.lignes %}
					<tr>
						<td>{{ ligne.coproprietaire }}</td>

						<td class="text-end">
							{{ ligne.tantiemes }}
						</td>

						<td class="text-end">
							{{ ligne.totalAppele|number_format(2, ',', ' ') }}
							€
						</td>

						<td class="text-end">
							{{ ligne.quotePartReelle|number_format(2, ',', ' ') }}
							€
						</td>

						<td class="text-end
							{% if ligne.estCrediteur %}
								text-success
							{% elseif ligne.estDebiteur %}
								text-danger
							{% endif %}
															">
							{{ ligne.regularisation|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5" class="text-center text-muted">
							Aucune régularisation à afficher.
						</td>
					</tr>
				{% endfor %}
			</tbody>

			<tfoot class="table-light fw-bold">
				<tr>
					<td colspan="2">
						Totaux
					</td>

					<td class="text-end">
						{{ simulation.totalAppels|number_format(2, ',', ' ') }}
						€
					</td>

					<td class="text-end">
						{{ simulation.totalCharges|number_format(2, ',', ' ') }}
						€
					</td>

					<td class="text-end">
						{{ simulation.regularisationGlobale|number_format(2, ',', ' ') }}
						€
					</td>
				</tr>
			</tfoot>
		</table>

	</div>
{% endblock %}
