{% extends 'base.html.twig' %}

{% block title %}Coproprietaire index
{% endblock %}

{% block body %}
	<h1>Coproprietaire index</h1>

	<table class="table">
		<thead>
			<tr>
				<th class="text-center">Nom</th>
				<th class="text-center">Prenom</th>
				<th class="text-center">Email</th>
				<th class="text-center">Telephone</th>
				<th class="text-center">Compte</th>
				<th class="text-center">Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for coproprietaire in coproprietaires %}
				<tr>
					<td class="text-center">{{ coproprietaire.nom }}</td>
					<td class="text-center">{{ coproprietaire.prenom }}</td>
					<td class="text-center">{{ coproprietaire.email }}</td>
					<td class="text-center">{{ coproprietaire.telephone }}</td>
					<td class="text-center">{{ coproprietaire.compte ? coproprietaire.compte.numero : '' }}</td>
					<td class="text-center">
						<div class="btn-group" role="group">
							<a href="{{ path('app_coproprietaire_show', {'id': coproprietaire.id}) }}" class="btn btn-sm btn-outline-secondary">show</a>
							<a href="{{ path('app_coproprietaire_edit', {'id': coproprietaire.id}) }}" class="btn btn-sm btn-outline-secondary">edit</a>

							{# Remplacement de l'ID en dur par la variable active de l'exercice #}
							<a href="{{ path('app_coproprietaire_etat_compte', { 'copro': coproprietaire.id}) }}" class="btn btn-sm btn-info">Compte
							</a>
							<a href="{{ path( 'app_coproprietaire_charges', { copro: coproprietaire.id } ) }}" class="btn btn-sm btn-secondary">
								Charges réparties
							</a>
						</div>
					</td>
				</tr>
			{% else %}
				<tr>
					{# Changement du colspan de 5 à 6 #}
					<td colspan="6" class="text-center text-muted">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_coproprietaire_new') }}" class="btn btn-success">Create new</a>
{% endblock %}
