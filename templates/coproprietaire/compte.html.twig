{% extends 'base.html.twig' %}

{% block title %}
	État de compte
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">

			<div>
				<h1 class="mb-0">État de compte -
					{{ exercice.nom }}
				</h1>

				<H2 class="text-muted">
					{{ copro.nom }}
					- Compte :
					{{ compte.numero }}
				</H2>
			</div>

			<div class="text-end">
				<div class="fw-bold">
					Solde
				</div>

				<div class="fs-4
																													{% if solde > 0 %} text-danger
																													{% elseif solde < 0 %} text-success
																													{% endif %}">
					{{ solde|number_format(2, ',', ' ') }}
					€
				</div>
			</div>

		</div>

		<div class="card shadow-sm">
			<div class="card-body p-0">
				<table class="table table-hover mb-0 align-middle">
					<thead class="table-light">
						<tr>
							<th>Exercice</th>
							<th class="text-center">Date</th>
							<th class="text-center">Pièce</th>
							<th class="text-center">Type</th>
							<th class="text-center">Libellé</th>
							<th class="text-center">Débit</th>
							<th class="text-center">Crédit</th>
							<th class="text-end">Solde</th>
						</tr>
					</thead>
					<tbody>
						{% for ligne in mvt %}
							<tr>
								<td>{{ ligne.exercice }}</td>
								<td class="text-center">{{ ligne.date|date('d/m/Y') }}</td>
								<td class="text-center">{{ ligne.piece }}</td>
								<td class="text-center">
									<span class="badge bg-secondary">{{ ligne.type }}</span>
								</td>
								<td class="text-center">{{ ligne.libelle }}</td>
								<td class="text-center text-danger">
									{% if ligne.debit > 0 %}
										{{ ligne.debit|number_format(2, ',', ' ') }}
										€
									{% endif %}
								</td>
								<td class="text-center text-success">
									{% if ligne.credit > 0 %}
										{{ ligne.credit|number_format(2, ',', ' ') }}
										€
									{% endif %}
								</td>
								<td class="text-end fw-bold">
									{{ ligne.solde|number_format(2, ',', ' ') }}
									€
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7" class="text-center py-4 text-muted">
									Aucun mouvement
								</td>
							</tr>

						{% endfor %}

					</tbody>

					<tfoot class="table-light">
						<tr>
							<th colspan="5" class="text-end">totaux</th>
							<th class="text-center text-danger">
								{{ totalDebit|number_format(2, ',', ' ') }}
								€
							</th>
							<th class="text-center text-success">
								{{ totalCredit|number_format(2, ',', ' ') }}
								€
							</th>
							<th class="text-end fw-bold">
								{{ solde|number_format(2, ',', ' ') }}
								€
							</th>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
