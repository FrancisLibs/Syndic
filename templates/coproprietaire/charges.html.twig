{% extends 'base.html.twig' %}

{% block title %}
    Répartition des charges
{% endblock %}

{% block body %}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Répartition des charges</h1>

            <p class="mb-0">
                <strong>Copropriétaire :</strong>
                {{ copro }}
            </p>

            <p class="mb-0">
                <strong>Exercice :</strong>
                {{ exercice.nom }}
            </p>
        </div>

        <div>
            <a
                href="{{ path(
                    'app_coproprietaire_show',
                    { id: copro.id }
                ) }}"
                class="btn btn-secondary"
            >
                Retour
            </a>
        </div>

    </div>

    {# ========================= #}
    {# Charges par type         #}
    {# ========================= #}

    <div class="card mb-4">

        <div class="card-header">
            Répartition des charges
        </div>

        <div class="card-body p-0">

            <table class="table table-striped mb-0">

                <thead>
                    <tr>
                        <th>Type de charge</th>
                        <th class="text-end">Montant</th>
                    </tr>
                </thead>

                <tbody>

                {% for libelle, montant in totaux %}

                    <tr>
                        <td>{{ libelle }}</td>

                        <td class="text-end">
                            {{ montant|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>

                {% else %}

                    <tr>
                        <td colspan="2" class="text-center">
                            Aucune charge répartie.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

                <tfoot>

                    <tr class="table-light">

                        <th>Total charges</th>

                        <th class="text-end">
                            {{ totalGeneral|number_format(2, ',', ' ') }} €
                        </th>

                    </tr>

                </tfoot>

            </table>

        </div>

    </div>

    {# ========================= #}
    {# Synthèse                 #}
    {# ========================= #}

    <div class="card">

        <div class="card-header">
            Synthèse de l'exercice
        </div>

        <div class="card-body">

            <table class="table">

                <tbody>

                    <tr>
                        <th>Charges réelles</th>

                        <td class="text-end">
                            {{ totalGeneral|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>

                    <tr>
                        <th>Appels de fonds</th>

                        <td class="text-end">
                            {{ totalAppels|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>

                    <tr class="table-primary">

                        <th>Régularisation</th>

                        <td class="text-end">
                            {{ regularisation|number_format(2, ',', ' ') }} €
                        </td>

                    </tr>

                </tbody>

            </table>

            <hr>

            {% if regularisation > 0 %}

                <div class="alert alert-warning mb-0">
                    Le copropriétaire doit encore
                    <strong>
                        {{ regularisation|number_format(2, ',', ' ') }} €
                    </strong>
                    à la copropriété.
                </div>

            {% elseif regularisation < 0 %}

                <div class="alert alert-success mb-0">
                    La copropriété doit rembourser
                    <strong>
                        {{ (-regularisation)|number_format(2, ',', ' ') }} €
                    </strong>
                    au copropriétaire.
                </div>

            {% else %}

                <div class="alert alert-info mb-0">
                    Situation équilibrée.
                </div>

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}