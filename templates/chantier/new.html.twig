{% extends 'base.html.twig' %}

{% block title %}Nouveau chantier{% endblock %}

{% block body %}

    <div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
        <h1>Nouveau chantier</h1>
    </div>

    {{ form_start(form) }}

        {{ form_row(form.libelle) }}
        {{ form_row(form.description) }}
        {{ form_row(form.montantVote) }}
        {{ form_row(form.modeRepartition) }}
        {{ form_row(form.financement) }}

        <div class="mt-4">
            <button class="btn btn-primary">
                Enregistrer
            </button>

            <a href="{{ path('app_chantier_index') }}"
               class="btn btn-secondary">
                Annuler
            </a>
        </div>

    {{ form_end(form) }}

{% endblock %}