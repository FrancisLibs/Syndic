{% extends 'base.html.twig' %}

{% block title %}TypeCharge
{% endblock %}

{% block body %}
	<h1>Type de Charge</h1>
	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ type_charge.id }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ type_charge.nom }}</td>
			</tr>
			<tr>
				<th>ModeRepartition</th>
				<td>{{ type_charge.modeRepartition.value }}</td>
			</tr>
			<tr>
				<th>Compte</th>
				<td>{{ type_charge.compte }}</td>
			</tr>
			<tr>
				<th>Charge d'eau</th>
				<td>
					{% if type_charge.estEau %}
						<span class="badge text-bg-primary">
							Oui
						</span>
					{% else %}
						<span class="text-muted">
							Non
						</span>
					{% endif %}
				</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_type_charge_index') }}">Retour à la liste</a>

	<a href="{{ path('app_type_charge_edit', {'id': type_charge.id}) }}">Modifier</a>

{% endblock %}
