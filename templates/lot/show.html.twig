{% extends 'base.html.twig' %}

{% block title %}Lot
{% endblock %}

{% block body %}
	<h1>Lot</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Reference</th>
				<td>{{ lot.reference }}</td>
			</tr>
			<tr>
				<th>Designation</th>
				<td>{{ lot.designation }}</td>
			</tr>
			<tr>
				<th>Tantiemes</th>
				<td>{{ lot.tantiemes }}</td>
			</tr>
			<tr>
				<th>Copropriétaire</th>
				<td>{{ lot.coproprietaireActuel }}</td>
			</tr>
		</tbody>
	</table>

	{# Compteur d'eau #}
	<div class="card shadow-sm mt-4">
		<div class="card-header">
			<strong>Compteur d’eau</strong>
		</div>

		<div class="card-body">
			{% if lot.compteurEau %}
				<dl class="row mb-0">
					<dt class="col-sm-3">Référence</dt>
					<dd class="col-sm-9">
						{{ lot.compteurEau.reference }}
					</dd>

					<dt class="col-sm-3">Index initial</dt>
					<dd class="col-sm-9">
						{{ lot.compteurEau.indexInitial ?? '—' }}
					</dd>

					<dt class="col-sm-3">Statut</dt>
					<dd class="col-sm-9">
						{% if lot.compteurEau.actif %}
							<span class="badge bg-success">Actif</span>
						{% else %}
							<span class="badge bg-secondary">Inactif</span>
						{% endif %}
					</dd>
				</dl>

				<div class="mt-3">
					<a
						class="btn btn-outline-primary"
						href="{{ path(
							'app_lot_compteur',
							{ id: lot.id }
						) }}"
					>
						Modifier le compteur
					</a>
				</div>
			{% else %}
				<p class="text-muted">
					Aucun compteur d’eau n’est associé à ce lot.
				</p>

				<a
					class="btn btn-primary"
					href="{{ path(
						'app_lot_compteur',
						{ id: lot.id }
					) }}"
				>
					Créer un compteur
				</a>
			{% endif %}
		</div>
	</div>

	<a href="{{ path('app_lot_index') }}">Retour à la liste</a>

	<a href="{{ path('app_lot_edit', {'id': lot.id}) }}">Modifier</a>

{% endblock %}
