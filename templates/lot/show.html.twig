{% extends 'base.html.twig' %}

{% block title %}Lot
{% endblock %}

{% block body %}
	<h1>Lot</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Reference</th>
				<td>{{ lot.reference }}</td>
			</tr>
			<tr>
				<th>Designation</th>
				<td>{{ lot.designation }}</td>
			</tr>
			<tr>
				<th>Tantiemes</th>
				<td>{{ lot.tantiemes }}</td>
			</tr>
			<tr>
				<th>Copropriétaire</th>
				<td>{{ lot.coproprietaireActuel }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_lot_index') }}">Retour à la liste</a>

	<a href="{{ path('app_lot_edit', {'id': lot.id}) }}">Modifier</a>

{% endblock %}
