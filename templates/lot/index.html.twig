{% extends 'base.html.twig' %}

{% block title %}Lot index
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-start align-items-baseline mb-3 gap-3">
		<h1>Liste des lots</h1>
		<h2>Total Tantièmes:
			{{ totalTantiemes }}</h2>
	</div>

	<table class="table">
		<thead>
			<tr>
				<th class="text-center">Reference</th>
				<th class="text-center">Designation</th>
				<th class="text-center">Tantiemes</th>
				<th class="text-center">Coproprietaire</th>
				<th class="text-center">Copropriete</th>
				<th class="text-center">actions</th>
			</tr>
		</thead>
		<tbody>
			{% for lot in lots %}
				<tr>
					<td class="text-center">{{ lot.reference }}</td>
					<td class="text-center">{{ lot.designation }}</td>
					<td class="text-center">{{ lot.tantiemes }}</td>
					<td class="text-center">{{ lot.coproprietaireActuel ? lot.coproprietaireActuel.nom : '—' }}</td>
					<td class="text-center">{{ lot.copropriete }}</td>
					<td class="text-center">
						<a href="{{ path('app_lot_show', {'id': lot.id}) }}">Voir</a>
						<a href="{{ path('app_lot_edit', {'id': lot.id}) }}">Modifier</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="6">Aucun lot trouvé</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_lot_new') }}">Créer un nouveau lot</a>
{% endblock %}
