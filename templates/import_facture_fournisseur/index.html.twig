{% extends 'base.html.twig' %}

{% block title %}
	Import des factures fournisseurs
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1>Import des factures fournisseurs</h1>
			<h2 class="h5 text-muted">
				{{ exercice.nom }}
			</h2>
		</div>

		<form method="post" action="{{ path( 'app_import_facture_fournisseur_traiter_tout' ) }}" onsubmit="return confirm(
													            'Traiter toutes les lignes en attente ou en erreur ?'
													        );">
			<input type="hidden" name="_token" value="{{ csrf_token('traiter_tout') }}">

			<button class="btn btn-success">
				Traiter toutes les lignes
			</button>
		</form>

		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1>Reprise des données</h1>

				<h2 class="h5 text-muted">
					{{ exercice.nom }}
				</h2>
			</div>


		</div>
	</div>

	<table class="table table-striped table-hover align-middle">
		<thead>
			<tr>
				<th>Statut</th>
				<th>Date</th>
				<th>Fournisseur</th>
				<th>Type de charge</th>
				<th>Numéro</th>
				<th>Libellé</th>
				<th class="text-end">Montant</th>
				<th>Réglée</th>
				<th>Actions</th>
			</tr>
		</thead>

		<tbody>
			{% for ligne in lignes %}
				<tr>
					<td>
						{% if ligne.estTraitee %}
							<span class="badge bg-success">
								Traitée
							</span>
						{% elseif ligne.estEnErreur %}
							<span class="badge bg-danger">
								Erreur
							</span>
						{% elseif ligne.estEnTraitement %}
							<span class="badge bg-info text-dark">
								Traitement
							</span>
						{% else %}
							<span class="badge bg-secondary">
								En attente
							</span>
						{% endif %}
					</td>

					<td>
						{{ ligne.dateFacture|date('d/m/Y') }}
					</td>

					<td>
						{{ ligne.fournisseur.nom }}
					</td>

					<td>
						{{ ligne.typeCharge.nom }}
					</td>

					<td>
						{{ ligne.numero ?: '—' }}
					</td>

					<td>
						{{ ligne.libelle }}
					</td>

					<td class="text-end">
						{{ ligne.montant|number_format(2, ',', ' ') }}
						€
					</td>

					<td>
						{% if ligne.reglee %}
							Oui
						{% else %}
							Non
						{% endif %}
					</td>

					<td>
						<div class="d-flex flex-wrap gap-1">
							<a href="{{ path( 'app_import_facture_fournisseur_show', {id: ligne.id} ) }}" class="btn btn-sm btn-outline-secondary">
								Voir
							</a>

							{% if not ligne.estTraitee %}
								<a href="{{ path( 'app_import_facture_fournisseur_edit', {id: ligne.id} ) }}" class="btn btn-sm btn-outline-primary">
									Modifier
								</a>
							{% endif %}

							{% if ligne.estEnAttente or ligne.estEnErreur %}
								<form method="post" action="{{ path( 'app_import_facture_fournisseur_traiter', {id: ligne.id} ) }}">
									<input type="hidden" name="_token" value="{{ csrf_token( 'traiter' ~ ligne.id ) }}">

									<button type="submit" class="btn btn-sm btn-success">
										Traiter
									</button>
								</form>
							{% endif %}

							{% if ligne.estEnErreur %}
								<form method="post" action="{{ path( 'app_import_facture_fournisseur_reinitialiser', {id: ligne.id} ) }}">
									<input type="hidden" name="_token" value="{{ csrf_token( 'reinitialiser' ~ ligne.id ) }}">

									<button type="submit" class="btn btn-sm btn-warning">
										Réinitialiser
									</button>
								</form>
							{% endif %}

							{% if not ligne.estTraitee %}
								<form method="post" action="{{ path( 'app_import_facture_fournisseur_delete', {id: ligne.id} ) }}" onsubmit="return confirm(
																																								                                        'Supprimer cette ligne ?'
																																								                                    );">
									<input type="hidden" name="_token" value="{{ csrf_token( 'delete' ~ ligne.id ) }}">

									<button type="submit" class="btn btn-sm btn-outline-danger">
										Supprimer
									</button>
								</form>
							{% endif %}
						</div>
					</td>
				</tr>

				{% if ligne.erreur %}
					<tr class="table-danger">
						<td colspan="9">
							<strong>Erreur :</strong>
							{{ ligne.erreur }}
						</td>
					</tr>
				{% endif %}
			{% else %}
				<tr>
					<td colspan="9" class="text-center text-muted">
						Aucune ligne d’import.
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
