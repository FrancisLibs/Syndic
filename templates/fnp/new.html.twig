{% extends 'base.html.twig' %}

{% block title %}
    Nouvelle facture non parvenue
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
        <h1>Nouvelle facture non parvenue</h1>
        <h2>{{ exercice.nom }}</h2>
    </div>

    <div class="alert alert-info">
        Cette écriture permet de rattacher à l'exercice
        une charge dont la facture n'a pas encore été reçue.
    </div>

    {{ form_start(form) }}

        {{ form_row(form.date) }}
        {{ form_row(form.typeCharge) }}
        {{ form_row(form.fournisseur) }}
        {{ form_row(form.libelle) }}
        {{ form_row(form.montant) }}
        {{ form_row(form.piece) }}

        <button class="btn btn-primary">
            Comptabiliser la FNP
        </button>

    {{ form_end(form) }}

{% endblock %}