{% extends 'base.html.twig' %}

{% block body %}

	<div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
		<h1>Paiements copropriétaires</h1>
		<h2>{{ exercice.nom }}</h2>
	</div>


	<table class="table table-striped">

		<thead>
			<tr>
				<th>Date</th>
				<th>Copropriétaire</th>
				<th>Montant</th>
				<th>Référence</th>
				<th></th>
			</tr>
		</thead>

		<tbody>

			{# templates/paiement/index.html.twig (ou approchant) #}

			{% for paiement in paiements %}
				{# 1. Si l'opération est annulée, on barre le texte et on met un fond rouge léger #}
				<tr {% if paiement.operation.statut.value == 'annule' %} class="table-light text-muted text-decoration-line-through" {% endif %}>
					<td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
					<td>{{ paiement.coproprietaire.nom }}</td>
					<td>{{ paiement.montant }}
						€</td>

					{# 2. Colonne Statut #}
					<td>
						{% if paiement.operation.statut.value == 'annule' %}
							<span class="badge bg-danger">
								<i class="fas fa-ban"></i>
								Annulé</span>
						{% else %}
							<span class="badge bg-success">
								<i class="fas fa-check"></i>
								Validé</span>
						{% endif %}
					</td>

					{# 3. Colonne Actions (On cache le bouton d'annulation si déjà annulé) #}
					<td>
						{% if paiement.operation.statut.value != 'annule' %}
							{# Ton bouton pour annuler #}
						{% endif %}
					</td>
				</tr>
			{% endfor %}

		</tbody>

	</table>

{% endblock %}
