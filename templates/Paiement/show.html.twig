{% extends 'base.html.twig' %}

{% block body %}

	<h1>Détail du paiement</h1>

	<div class="card">

		<div class="card-body">

			<table class="table">

				<tbody>
					<tr>
						<th>ID</th>
						<td>{{ paiement.id }}</td>
					</tr>
					<tr>
						<th>Date</th>
						<td>
							{{ paiement.datePaiement|date('d/m/Y') }}
						</td>
					</tr>
					<tr>
						<th>Copropriétaire</th>
						<td>
							{{ paiement.coproprietaire }}
						</td>
					</tr>
					<tr>
						<th>Exercice</th>
						<td>
							{{ paiement.exercice }}
						</td>
					</tr>
					<tr>
						<th>Montant</th>
						<td>
							{{ paiement.montant }}
							€
						</td>
					</tr>
					<tr>
						<th>Pièce justificative</th>
						<td>
							{{ paiement.piece }}
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<h2 class="mt-4">
		Affectations
	</h2>

	<table class="table table-bordered">

		<thead>

			<tr>
				<th>Appel</th>
				<th>Montant affecté</th>
			</tr>

		</thead>

		<tbody>

			{% for affectation in paiement.affectations %}
				<tr>

					<td>
						Appel #{{ affectation.ligneAppel.appelFond.id }}
					</td>

					<td>
						{{ affectation.montant }}
						€
					</td>

				</tr>

			{% else %}

				<tr>

					<td colspan="2">
						Aucune affectation
					</td>

				</tr>

			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_paiement_index') }}">
		Retour à la liste des paiements
	</a>

{% endblock %}
