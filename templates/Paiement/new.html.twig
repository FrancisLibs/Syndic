{% extends 'base.html.twig' %}

{% block body %}
	<div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
		<h1>Enregistrer un paiement</h1>
		<h2>{{ exercice.nom }}</h2>
	</div>

	{{ form_start(form) }}

	<div class="row">

		<div class="col-md-3">
			{{ form_row(form.datePaiement) }}
		</div>

		<div class="col-md-3">
			{{ form_row(form.coproprietaire) }}
		</div>

	</div>

	<div class="row mt-3">

		<div class="col-md-3">
			{{ form_row(form.montant) }}
		</div>

		<div class="col-md-3">
			{{ form_row(form.reference) }}
		</div>

	</div>

	<button type="submit" class="btn btn-success mt-3">
		Valider le paiement
	</button>

	{{ form_end(form) }}

{% endblock %}
