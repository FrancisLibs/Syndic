{% extends 'base.html.twig' %}

{% block body %}
	<h1>Nouvelle charge</h1>

	{{ form_start(form) }}
	<div class="row">
		<div class="col-5">
			{{ form_row(form.libelle) }}
		</div>
	</div>
	<div class="row">
		<div class="col-3">
			{{ form_row(form.date) }}
		</div>
		<div class="col-3">
			{{ form_row(form.fournisseur) }}
		</div>
	</div>
	<div class="row">
		<div class="col-3">
			{{ form_row(form.montant) }}
		</div>
		<div class="col-3">
			{{ form_row(form.typeCharge) }}
		</div>
	</div>


	<button class="btn btn-primary">Enregistrer</button>
	{{ form_end(form) }}
{% endblock %}
