{% extends 'base.html.twig' %}

{% block title %}
	Balance comptable
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">

			<div>
				<h1 class="mb-0">
					Balance comptable
				</h1>

				<p class="text-muted">
					Situation des comptes
				</p>
			</div>

		</div>

		<div class="card shadow-sm">

			<div class="card-body p-0">

				<table class="table table-hover table-striped mb-0">

					<thead class="table-dark">

						<tr>

							<th>
								Compte
							</th>

							<th>
								Libellé
							</th>

							<th class="text-end">
								Débit
							</th>

							<th class="text-end">
								Crédit
							</th>

							<th class="text-end">
								Solde
							</th>

						</tr>

					</thead>

					<tbody>

						{% set totalDebit = 0 %}
						{% set totalCredit = 0 %}
						{% set totalSolde = 0 %}

						{% for ligne in balance %}

							{% set totalDebit = totalDebit + ligne.debit %}
							{% set totalCredit = totalCredit + ligne.credit %}
							{% set totalSolde = totalSolde + ligne.solde %}

							<tr>

								<td class="fw-bold">
									{{ ligne.numero }}
								</td>

								<td>
									{{ ligne.libelle }}
								</td>

								<td class="text-end">

									{% if ligne.debit > 0 %}
										{{ ligne.debit|number_format(2, ',', ' ') }}
									{% endif %}

								</td>

								<td class="text-end">

									{% if ligne.credit > 0 %}
										{{ ligne.credit|number_format(2, ',', ' ') }}
									{% endif %}

								</td>

								<td class="text-end fw-bold">

									{% if ligne.solde != 0 %}

										<span class="
																								                                        {{ ligne.solde > 0
																								                                            ? 'text-danger'
																								                                            : 'text-success'
																								                                        }}
																								                                    ">

											{{ ligne.solde|number_format(2, ',', ' ') }}

										</span>

									{% else %}

										0,00

									{% endif %}

								</td>

							</tr>

						{% else %}

							<tr>

								<td colspan="5" class="text-center py-4 text-muted">

									Aucune écriture comptable

								</td>

							</tr>

						{% endfor %}

					</tbody>

					<tfoot class="table-light fw-bold">

						<tr>

							<td colspan="2">
								Totaux
							</td>

							<td class="text-end">
								{{ totalDebit|number_format(2, ',', ' ') }}
							</td>

							<td class="text-end">
								{{ totalCredit|number_format(2, ',', ' ') }}
							</td>

							<td class="text-end">

								<span class="
										                                    {{
										                                        totalDebit == totalCredit
										                                        ? 'text-success'
										                                        : 'text-danger'
										                                    }}
										                                ">

									{{
                                    (totalDebit - totalCredit)
                                    |number_format(2, ',', ' ')
                                }}

								</span>

							</td>

						</tr>

					</tfoot>

				</table>

			</div>

		</div>

		<div class="mt-3">

			{% if totalDebit == totalCredit %}

				<div class="alert alert-success">

					Balance équilibrée : débits = crédits.

				</div>

			{% else %}

				<div class="alert alert-danger">

					Balance déséquilibrée : vérifier les écritures comptables.

				</div>

			{% endif %}

		</div>

	</div>

{% endblock %}
