{% extends 'base.html.twig' %}

{% block title %}
	Balance comptable
{% endblock %}

{% block body %}
	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="mb-0">
					Balance comptable -
					{{ exercice.nom }}
				</h1>

				<p class="text-muted">
					Situation des comptes
				</p>
			</div>
		</div>

		<div class="card shadow-sm">
			<div class="card-body p-0">

				<table class="table table-hover table-striped mb-0">

					<thead class="table-dark">
						<tr>
							<th>Compte</th>
							<th>Libellé</th>
							<th class="text-end">Débit</th>
							<th class="text-end">Crédit</th>
							<th class="text-end">Solde débiteur</th>
							<th class="text-end">Solde créditeur</th>
						</tr>
					</thead>

					<tbody>
						{% for ligne in balance %}
							<tr>
								<td class="fw-bold">
									{{ ligne.numero }}
								</td>

								<td>
									{{ ligne.libelle }}
								</td>

								<td class="text-end">
									{% if ligne.debit != 0 %}
										{{ ligne.debit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="text-end">
									{% if ligne.credit != 0 %}
										{{ ligne.credit|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="text-end">
									{% if ligne.soldeDebiteur != 0 %}
										{{ ligne.soldeDebiteur|number_format(2, ',', ' ') }}
									{% endif %}
								</td>

								<td class="text-end">
									{% if ligne.soldeCrediteur != 0 %}
										{{ ligne.soldeCrediteur|number_format(2, ',', ' ') }}
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center py-4 text-muted">
									Aucune écriture comptable
								</td>
							</tr>
						{% endfor %}
					</tbody>

					<tfoot class="table-light fw-bold">
						<tr>
							<td colspan="2">
								Totaux
							</td>

							<td class="text-end">
								{{ totalDebit|number_format(2, ',', ' ') }}
							</td>

							<td class="text-end">
								{{ totalCredit|number_format(2, ',', ' ') }}
							</td>

							<td class="text-end">
								{{ totalSoldeDebiteur|number_format(2, ',', ' ') }}
							</td>

							<td class="text-end">
								{{ totalSoldeCrediteur|number_format(2, ',', ' ') }}
							</td>
						</tr>
					</tfoot>

				</table>

			</div>
		</div>

		<div class="mt-3">
			{% if equilibree %}
				<div class="alert alert-success">
					Balance équilibrée.
				</div>
			{% else %}
				<div class="alert alert-danger">
					Balance déséquilibrée : vérifier les écritures comptables.
				</div>
			{% endif %}
		</div>

	</div>
{% endblock %}
