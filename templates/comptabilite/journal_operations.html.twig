{# templates/comptabilite/journal_operations.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}
	Journal des Opérations
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="row align-items-center mb-4">
			<div class="col-md-6">

				<h2>Journal des Opérations</h2>

				{% if exercice %}
					<p class="text-muted">
						Exercice :
						<strong>{{ exercice.nom }}</strong>
						(du
						{{ exercice.dateDebut|date('d/m/Y') }}
						au
						{{ exercice.dateFin|date('d/m/Y') }})
					</p>
				{% endif %}

			</div>

			<div class="col-md-6 text-end">
				<a href="{{ path('app_operation_diverse_new') }}" class="btn btn-primary">
					Nouvelle opération diverse
				</a>
			</div>
		</div>

		<table class="table table-hover align-middle shadow-sm mt-3">

			<thead class="table-dark">
				<tr>
					<th>Date</th>
					<th>Type</th>
					<th>Libellé / Pièce</th>
					<th class="text-center">Statut</th>
					<th>Montants</th>
					<th class="text-center">Actions</th>
				</tr>
			</thead>

			<tbody>

				{% for op in operations %}

					<tr class="{{ op.statut.value == 'annule' ? 'table-light text-muted opacity-75' : '' }}">

						<td>
							{{ op.date|date('d/m/Y') }}
						</td>

						<td>

							{% if op.type.value == 'paiement' %}

								<span class="badge bg-success">
									Paiement copropriétaire
								</span>

							{% elseif op.type.value == 'appel_fonds' %}

								<span class="badge bg-primary">
									Appel de fonds
								</span>

							{% elseif op.type.value == 'charge' %}

								<span class="badge bg-secondary">
									Facture fournisseur
								</span>

							{% elseif op.type.value == 'paiement_fournisseur' %}

								<span class="badge bg-info text-dark">
									Paiement fournisseur
								</span>

							{% elseif op.type.value == 'remboursement_fournisseur' %}

								<span class="badge bg-info text-dark">
									Remboursement fournisseur
								</span>

							{% elseif op.type.value == 'remboursement_coprop' %}

								<span class="badge bg-info text-dark">
									Remboursement copropriétaire
								</span>

							{% elseif op.type.value == 'a_nouveau' %}

								<span class="badge bg-warning text-dark">
									À-nouveau
								</span>

							{% elseif op.type.value == 'cloture' %}

								<span class="badge bg-dark">
									Clôture
								</span>

							{% elseif op.type.value == 'approbation_comptes' %}

								<span class="badge bg-dark">
									Approbation des comptes
								</span>

							{% elseif op.type.value == 'regularisation' %}

								<span class="badge bg-dark">
									Régularisation
								</span>

							{% elseif op.type.value == 'transfert_dette' %}

								<span class="badge bg-dark">
									Transfert de dette
								</span>

							{% elseif op.type.value == 'operation_diverse' %}

								<span class="badge bg-dark">
									Opération diverse
								</span>

							{% else %}

								<span class="badge bg-dark">
									{{ op.type.value }}
								</span>

							{% endif %}

						</td>

						<td>

							<strong>
								{{ op.libelle }}
							</strong>

							{% if op.piece %}
								<br>
								<small class="text-muted">
									N° Pièce :
									{{ op.piece }}
								</small>
							{% endif %}

						</td>

						<td class="text-center">

							{% if op.statut.value == 'valide' %}

								<span class="badge bg-success-subtle
										                                   text-success
										                                   border border-success">
									Valide
								</span>

							{% else %}

								<span class="badge bg-danger-subtle
										                                   text-danger
										                                   border border-danger">
									Annulée
								</span>

							{% endif %}

						</td>

						<td>

							{% for ecriture in op.ecritures %}

								<div>
									{{ ecriture.compte }}

									{% if ecriture.debit > 0 %}
										:
										                                Débit
										{{ ecriture.debit
                                    |number_format(2, ',', ' ')
                                }}
										€
									{% endif %}

									{% if ecriture.credit > 0 %}
										:
										                                Crédit
										{{ ecriture.credit
                                    |number_format(2, ',', ' ')
                                }}
										€
									{% endif %}
								</div>

							{% endfor %}

						</td>

						<td class="text-center">

							<div class="d-flex gap-2 justify-content-center">

								<a href="{{ path( 'app_operation_show', {'id': op.id} ) }}" class="btn btn-sm btn-outline-primary">
									Voir
								</a>

								{% if op.statut.value != 'annule' %}

									<form method="post" action="{{ path( 'app_operation_annuler', {'id': op.id} ) }}" onsubmit="
											                                    return confirm(
											                                        'Êtes-vous sûr de vouloir annuler cette opération ?'
											                                    );
											                                ">

										<input type="hidden" name="_token" value="{{ csrf_token( 'annuler' ~ op.id ) }}">

										<button type="submit" class="btn btn-sm btn-danger">
											Annuler
										</button>

									</form>

								{% else %}

									<span class="badge bg-secondary">
										Opération annulée
									</span>

								{% endif %}

							</div>

						</td>

					</tr>

				{% else %}

					<tr>
						<td colspan="6" class="text-center text-muted">
							Aucune opération enregistrée.
						</td>
					</tr>

				{% endfor %}

			</tbody>

		</table>

	</div>

{% endblock %}
