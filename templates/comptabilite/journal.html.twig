{% extends 'base.html.twig' %}

{% block title %}
	Journal comptable
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">

			<div>

				<h1 class="mb-0">
					Journal comptable
				</h1>

				<p class="text-muted">
					Historique des écritures
				</p>

			</div>

		</div>

		<div class="card shadow-sm">

			<div class="card-body p-0">

				<table class="table table-hover table-striped mb-0">

					<thead class="table-dark">

						<tr>
							<th>Exercice</th>
							<th>Date</th>

							<th>Type</th>

							<th>Libellé</th>

							<th>Compte</th>

							<th>Compte libellé</th>

							<th class="text-end">
								Débit
							</th>

							<th class="text-end">
								Crédit
							</th>

						</tr>

					</thead>

					<tbody>

						{% set totalDebit = 0 %}
						{% set totalCredit = 0 %}

						{% for ligne in lignes %}

							{% set totalDebit = totalDebit + ligne.debit %}
							{% set totalCredit = totalCredit + ligne.credit %}

							<tr>
								<td>
									{{ ligne.exercice }}
								</td>	
															
								<td>
									{{ ligne.date|date('d/m/Y') }}
								</td>

								<td>

									<span class="badge bg-secondary">

										{{ ligne.type }}

									</span>

								</td>

								<td>
									{{ ligne.libelle }}
								</td>

								<td class="fw-bold">
									{{ ligne.compte }}
								</td>

								<td>
									{{ ligne.compteLibelle }}
								</td>

								<td class="text-end">

									{% if ligne.debit > 0 %}

										{{
                                        ligne.debit
                                        |number_format(2, ',', ' ')
                                    }}

									{% endif %}

								</td>

								<td class="text-end">

									{% if ligne.credit > 0 %}

										{{
                                        ligne.credit
                                        |number_format(2, ',', ' ')
                                    }}

									{% endif %}

								</td>

							</tr>

						{% else %}

							<tr>

								<td colspan="7" class="text-center py-4 text-muted">

									Aucune écriture

								</td>

							</tr>

						{% endfor %}

					</tbody>

					<tfoot class="table-light fw-bold">

						<tr>

							<td colspan="5">
								Totaux
							</td>

							<td class="text-end">

								{{
                                totalDebit
                                |number_format(2, ',', ' ')
                            }}

							</td>

							<td class="text-end">

								{{
                                totalCredit
                                |number_format(2, ',', ' ')
                            }}

							</td>

						</tr>

					</tfoot>

				</table>

			</div>

		</div>

		<div class="mt-3">

			{% if totalDebit == totalCredit %}

				<div class="alert alert-success">

					Journal équilibré :
					                débits = crédits.

				</div>

			{% else %}

				<div class="alert alert-danger">

					Journal déséquilibré :
					                vérifier les écritures.

				</div>

			{% endif %}

		</div>

	</div>

{% endblock %}
