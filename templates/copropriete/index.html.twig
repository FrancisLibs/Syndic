{% extends 'base.html.twig' %}

{% block title %}Copropriete index{% endblock %}

{% block body %}
    <h1>Copropriétés</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Adresse</th>
                <th>CodePostal</th>
                <th>Localité</th>
                <th>TantiemesBase</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for copropriete in coproprietes %}
            <tr>
                <td>{{ copropriete.nom }}</td>
                <td>{{ copropriete.adresse }}</td>
                <td>{{ copropriete.codePostal }}</td>
                <td>{{ copropriete.localite }}</td>
                <td>{{ copropriete.tantiemesBase }}</td>
                <td>
                    <a href="{{ path('app_copropriete_show', {'id': copropriete.id}) }}">Voir</a>
                    <a href="{{ path('app_copropriete_edit', {'id': copropriete.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucune copropriété enregistrée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_copropriete_new') }}">Créer une nouvelle copropriété</a>
{% endblock %}
