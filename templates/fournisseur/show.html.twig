{% extends 'base.html.twig' %}

{% block title %}Fournisseur{% endblock %}

{% block body %}
    <h1>{{ fournisseur.nom }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ fournisseur.id }}</td>
            </tr>
            <tr>
                <th>Compte</th>
                <td>{{ fournisseur.compte }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ fournisseur.adresse }}</td>
            </tr>
            <tr>
                <th>CodePostal</th>
                <td>{{ fournisseur.codePostal }}</td>
            </tr>
            <tr>
                <th>Localite</th>
                <td>{{ fournisseur.localite }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_fournisseur_index') }}">Retour à la liste</a>

    <a href="{{ path('app_fournisseur_edit', {'id': fournisseur.id}) }}">Modifier</a>
{% endblock %}
