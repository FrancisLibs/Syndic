{% extends 'base.html.twig' %}

{% block title %}
	Factures fournisseurs
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1 class="mb-0">
				Factures fournisseurs
			</h1>

			<p class="text-muted mb-0">Exercice consulté : <strong>{{ exercice.nom }}</strong></p>
		</div>

		<a
			class="btn btn-primary"
			href="{{ path('app_facture_fournisseur_new') }}"
		>
			Nouvelle facture
		</a>

	</div>

	<div class="card shadow-sm">
		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table table-hover align-middle mb-0">

					<thead class="table-light">
						<tr>
							<th>Exercice</th>
							<th>Fournisseur</th>
							<th>Numéro</th>
							<th>Libellé</th>
							<th>Date</th>
							<th>Échéance</th>
							<th class="text-end">Montant</th>
							<th class="text-end">Réglé</th>
							<th class="text-end">Reste à payer</th>
							<th>Statut</th>
							<th>Comptabilité</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>

					<tbody>

						{% for facture in factures %}

							<tr>

								<td>
									<div class="fw-semibold">
										{{ facture.exercice.nom }}
									</div>

									{% if facture.exercice.cloture %}
										<span class="badge bg-secondary">
											Clôturé
										</span>
									{% elseif facture.exercice.actif %}
										<span class="badge bg-success">
											Actif
										</span>
									{% else %}
										<span class="badge bg-light text-dark border">
											Ouvert
										</span>
									{% endif %}
								</td>

								<td>
									{{ facture.fournisseur.nom }}
								</td>

								<td>
									{{ facture.numero }}
								</td>

								<td>
									{{ facture.libelle }}
								</td>

								<td>
									{{ facture.dateFacture
										? facture.dateFacture|date('d/m/Y')
										: '—'
									}}
								</td>

								<td>
									{{ facture.dateEcheance
										? facture.dateEcheance|date('d/m/Y')
										: '—'
									}}
								</td>

								<td class="text-end text-nowrap">
									{{ facture.montant|number_format(2, ',', ' ') }}
									€
								</td>

								<td class="text-end text-nowrap">
									{{ facture.montantRegle|number_format(2, ',', ' ') }}
									€
								</td>

								<td class="text-end fw-semibold text-nowrap">

									{% if facture.resteAPayer > 0 %}

										<span class="text-danger">
											{{ facture.resteAPayer|number_format(2, ',', ' ') }}
											€
										</span>

									{% else %}

										<span class="text-success">
											0,00 €
										</span>

									{% endif %}

								</td>

								<td>

									{% if facture.soldee %}

										<span class="badge bg-success">
											Soldée
										</span>

									{% elseif facture.montantRegle > 0 %}

										<span class="badge bg-warning text-dark">
											Partiellement réglée
										</span>

									{% else %}

										<span class="badge bg-danger">
											À régler
										</span>

									{% endif %}

								</td>

								<td>

									{% if facture.comptabilisee %}

										<span class="badge bg-success">
											Comptabilisée
										</span>

									{% else %}

										<span class="badge bg-warning text-dark">
											À comptabiliser
										</span>

									{% endif %}

								</td>

								<td>

									<div class="d-flex justify-content-end gap-2">

										<a
											class="btn btn-sm btn-outline-primary"
											href="{{ path(
												'app_facture_fournisseur_show',
												{
													id: facture.id
												}
											) }}"
										>
											Voir
										</a>

										{% if
											not facture.comptabilisee
											and not facture.exercice.cloture
										%}

											<a
												class="btn btn-sm btn-outline-secondary"
												href="{{ path(
													'app_facture_fournisseur_edit',
													{
														id: facture.id
													}
												) }}"
											>
												Modifier
											</a>

										{% endif %}

										{% if not facture.soldee %}

											<form
												method="post"
												action="{{ path(
													'app_facture_fournisseur_regler',
													{
														id: facture.id
													}
												) }}"
											>

												<input
													type="hidden"
													name="_token"
													value="{{ csrf_token(
														'regler_facture_' ~ facture.id
													) }}"
												>

												<button
													type="submit"
													class="btn btn-sm btn-success"
												>
													Régler
												</button>

											</form>

										{% endif %}

									</div>

								</td>

							</tr>

						{% else %}

							<tr>
								<td
									colspan="12"
									class="text-center text-muted py-4"
								>
									Aucune facture fournisseur trouvée
								</td>
							</tr>

						{% endfor %}

					</tbody>

				</table>

			</div>

		</div>
	</div>

{% endblock %}
