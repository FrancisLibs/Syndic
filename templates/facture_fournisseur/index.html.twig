{% extends 'base.html.twig' %}

{% block title %}FactureFournisseur index
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">
		<h1>Liste Facture Fournisseurs</h1>
		<h2>{{ exercice.nom }}</h2>
	</div>


	<table class="table">
		<thead>
			<tr>
				<th>Fournisseur</th>
				<th>Numero</th>
				<th>Libelle</th>
				<th>DateFacture</th>
				<th>DateEcheance</th>
				<th>Montant</th>
				<th>MontantRegle</th>
				<th>Soldee</th>
				<th>Comptabilisee</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for facture in factures %}
				<tr>
					<td>{{ facture.fournisseur.nom }}</td>
					<td>{{ facture.numero }}</td>
					<td>{{ facture.libelle }}</td>
					<td>{{ facture.dateFacture ? facture.dateFacture|date('Y-m-d') : '' }}</td>
					<td>{{ facture.dateEcheance ? facture.dateEcheance|date('Y-m-d') : '' }}</td>
					<td>{{ facture.montant }}</td>
					<td>{{ facture.montantRegle }}</td>
					<td>{{ facture.soldee ? 'Yes' : 'No' }}</td>
					<td>{{ facture.comptabilisee ? 'Yes' : 'No' }}</td>
					<td class="d-flex gap-2">
						<a href="{{ path('app_facture_fournisseur_show', {'id': facture.id}) }}">Voir</a>

						{% if not facture.comptabilisee %}
							<a href="{{ path('app_facture_fournisseur_edit', {'id': facture.id}) }}">
								Editer
							</a>
						{% endif %}
						<div class="me-3">
							{% if  not facture.soldee %}
								<form method="post" action="{{ path( 'app_facture_fournisseur_regler', { id: facture.id } ) }}">
									<button class="btn btn-success btn-sm">
										Régler la facture
									</button>
								</form>
							{% endif %}
						</div>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="10">Aucune facture trouvée</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_facture_fournisseur_new') }}">Nouvelle facture</a>

{% endblock %}
