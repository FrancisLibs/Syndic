{% extends 'base.html.twig' %}

{% block title %}
	Factures fournisseurs
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1 class="mb-0">
				Factures fournisseurs
			</h1>

			<p class="text-muted mb-0">
				Exercice consulté :
				<strong>{{ exercice.nom }}</strong>
			</p>
		</div>

		<div>
			<a class="btn btn-primary" href="{{ path('app_facture_fournisseur_new') }}">
				Nouvelle facture
			</a>
		</div>

	</div>

	<div class="card shadow-sm">

		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table table-hover align-middle mb-0">

					<thead class="table-light">
						<tr>
							<th>Exercice</th>
							<th>Bénéficiaire</th>
							<th>Numéro</th>
							<th>Libellé</th>
							<th>Date</th>
							<th class="text-end">Montant</th>
							<th class="text-end">Réglé</th>
							<th class="text-end">Reste à régler</th>
							<th>Règlement</th>
							<th>Comptabilité</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>

					<tbody>

						{% set typeCourant = null %}
						{% set sousTotal = 0 %}

						{% for facture in factures %}

							{% if facture.chantier %}
								{% set groupeFacture = 'Travaux - ' ~ facture.chantier.libelle %}
							{% elseif facture.typeCharge %}
								{% set groupeFacture = facture.typeCharge.nom %}
							{% else %}
								{% set groupeFacture = 'Sans affectation' %}
							{% endif %}

							{# ============================ #}
							{# Changement de type de charge #}
							{# ============================ #}

							{% if typeCourant != groupeFacture %}

								{# Sous-total du groupe précédent #}
								{% if typeCourant is not null %}

									<tr class="table-secondary"> <td colspan="5" class="text-end fw-bold">
											Sous-total {{ typeCourant }}
										</td>

										<td class="text-end fw-bold text-nowrap">
											{{ sousTotal|number_format(2, ',', ' ') }}
											€
										</td>

										<td colspan="2"></td>

									</tr>

								{% endif %}

								{% set typeCourant = groupeFacture %}
								{% set sousTotal = 0 %}

								{# Titre du nouveau groupe #}

								<tr class="table-primary">

									<td colspan="8" class="fw-bold">

										{{ typeCourant }}

									</td>

								</tr>

							{% endif %}

							{% set sousTotal =
                                sousTotal + facture.montant
                            %}

							{# ============================ #}
							{# Facture                      #}
							{# ============================ #}

							<tr>

								<td>

									<div class="fw-semibold"> {{ facture.exercice.nom }}
									</div>

									{% if facture.exercice.cloture %}

										<span class="badge bg-secondary">
											Clôturé
										</span>

									{% elseif facture.exercice.actif %}

										<span class="badge bg-success">
											Actif
										</span>

									{% else %}

										<span class="badge bg-light text-dark border">
											Ouvert
										</span>

									{% endif %}

								</td>

								<td>

									{% if facture.fournisseur %}

										{{ facture.fournisseur.nom }}

									{% elseif facture.coproprietaireAvanceur %}

										{{ facture.coproprietaireAvanceur }}

									{% else %}

										—

									{% endif %}

								</td>

								<td>
									{{ facture.numero }}
								</td>

								<td>
									{{ facture.libelle }}
								</td>

								<td>

									{{ facture.dateFacture
                                        ? facture.dateFacture|date('d/m/Y')
                                        : '—'
                                    }}

								</td>

								<td class="text-end text-nowrap">

									{{ facture.montant
                                        |number_format(2, ',', ' ')
                                    }}
									€

								</td>

								{% if facture.comptabilisee
									and facture.estFacture()
									and not facture.fnp
									and facture.coproprietaireAvanceur is null
								%}

									<td class="text-end text-nowrap">
										{{ facture.montantRegle|number_format(2, ',', ' ') }} €
									</td>

									<td class="text-end text-nowrap">
										{{ facture.resteARegler|number_format(2, ',', ' ') }} €
									</td>

									<td>
										{% if facture.estSoldee() %}
											<span class="badge bg-success">
												Réglée
											</span>
										{% elseif facture.montantRegle > 0 %}
											<span class="badge bg-warning text-dark">
												Partielle
											</span>
										{% else %}
											<span class="badge bg-danger">
												Non réglée
											</span>
										{% endif %}
									</td>

								{% else %}

									<td class="text-center text-muted">—</td>
									<td class="text-center text-muted">—</td>
									<td>
										<span class="badge bg-secondary">
											Non applicable
										</span>
									</td>

								{% endif %}

								<td>

									{% if facture.comptabilisee %}

										<span class="badge bg-success">
											Comptabilisée
										</span>

									{% else %}

										<span class="badge bg-warning text-dark">
											À comptabiliser
										</span>

									{% endif %}

								</td>

								<td>

									<div class="d-flex justify-content-end gap-2">

										<a class="btn btn-sm btn-outline-primary" href="{{ path('app_facture_fournisseur_show', { id: facture.id }) }}">
											Voir
										</a>

										{% if
                                            not facture.comptabilisee
                                            and not facture.exercice.cloture
                                        %}

											<a class="btn btn-sm btn-outline-secondary" href="{{ path('app_facture_fournisseur_edit', { id: facture.id }) }}">
												Modifier
											</a>

										{% endif %}

										{% if
                                            facture.comptabilisee
                                            and not facture.exercice.cloture
                                            and facture.coproprietaireAvanceur is null
                                        %}

											<a class="btn btn-sm btn-outline-warning" href="{{ path('app_facture_fournisseur_corriger_montant', { id: facture.id }) }}">
												Corriger montant
											</a>

										{% endif %}

									</div>

								</td>

							</tr>

						{% else %}

							<tr>
								<td colspan="8" class="text-center text-muted py-4">
									Aucune facture fournisseur trouvée
								</td>
							</tr>

						{% endfor %}

						{# ============================ #}
						{# Sous-total du dernier groupe #}
						{# ============================ #}

						{% if typeCourant is not null %}

							<tr class="table-secondary"> <td colspan="5" class="text-end fw-bold">
									Sous-total
									{{ typeCourant }}
								</td>

								<td class="text-end fw-bold text-nowrap">
									{{ sousTotal|number_format(2, ',', ' ') }}
									€
								</td>

								<td colspan="2"></td>

							</tr>

						{% endif %}

					</tbody>

				</table>

			</div>

		</div>

	</div>

{% endblock %}
