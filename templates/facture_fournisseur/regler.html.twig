{% extends 'base.html.twig' %}

{% block title %}
	Règlement d’une facture fournisseur
{% endblock %}

{% block body %}

	<h1>Régler une facture fournisseur</h1>

	<div class="mb-4">
		<p>
			<strong>Fournisseur :</strong>
			{{ facture.fournisseur.nom }}
		</p>

		<p>
			<strong>Facture :</strong>
			{{ facture.numero ?: facture.libelle }}
		</p>

		<p>
			<strong>Montant :</strong>
			{{ facture.montant|number_format(2, ',', ' ') }}
			€
		</p>
	</div>

	{{ form_start(form) }}

	{{ form_row(form.dateReglement) }}

	<button class="btn btn-success">
		Enregistrer le règlement
	</button>

	{{ form_end(form) }}

	<a href="{{ path('app_facture_fournisseur_index') }}" class="btn btn-secondary mt-3">
		Annuler
	</a>

{% endblock %}
