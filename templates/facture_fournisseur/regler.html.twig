{% extends 'base.html.twig' %}

{% block title %}
	Règlement d’une facture fournisseur
{% endblock %}

{% block body %}

	<div class="container py-4">

		<div class="mb-4">

			<h1>
				Régler une facture fournisseur
			</h1>

			<div class="text-muted">
				{{ facture.fournisseur.nom }}
			</div>

		</div>

		<div class="card mb-4">

			<div class="card-header">
				Facture
			</div>

			<div class="card-body">

				<div class="row">

					<div class="col-md-3">
						<strong>Numéro</strong>
						<div>
							{{ facture.numero ?: '-' }}
						</div>
					</div>

					<div class="col-md-3">
						<strong>Date</strong>
						<div>
							{{ facture.dateFacture|date('d/m/Y') }}
						</div>
					</div>

					<div class="col-md-3">
						<strong>Montant</strong>
						<div>
							{{ facture.montant|number_format(2, ',', ' ') }}
							€
						</div>
					</div>

					<div class="col-md-3">
						<strong>Reste à payer</strong>
						<div class="fw-bold">
							{{ facture.resteAPayer|number_format(2, ',', ' ') }}
							€
						</div>
					</div>

				</div>

			</div>

		</div>

		<div class="card mb-4">

			<div class="card-header">
				Crédits disponibles
			</div>

			<div class="card-body">

				{% if creditDisponible > 0.009 %}

					<div class="alert alert-info">

						<strong>
							Crédit total disponible :
						</strong>

						{{ creditDisponible|number_format(2, ',', ' ') }}
						€

					</div>

					<table class="table table-sm">

						<thead>
							<tr>
								<th>Date</th>
								<th>Référence</th>
								<th class="text-end">
									Montant règlement
								</th>
								<th class="text-end">
									Déjà affecté
								</th>
								<th class="text-end">
									Disponible
								</th>
								<th class="text-end">
									À utiliser
								</th>
							</tr>
						</thead>

						<tbody>

							{% for reglement in reglementsDisponibles %}

								<tr>

									<td>
										{{ reglement.dateReglement|date('d/m/Y') }}
									</td>

									<td>
										{{ reglement.reference ?: '-' }}
									</td>

									<td class="text-end">
										{{ reglement.montant|number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-end">
										{{ reglement.montantAffecte|number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-end fw-bold">
										{{ reglement.montantNonAffecte|number_format(2, ',', ' ') }}
										€
									</td>

									<td class="text-end" style="width: 160px;">
										<input type="number" class="form-control form-control-sm montant-credit" name="credits[{{ reglement.id }}]" value="0.00" min="0" max="{{ reglement.montantNonAffecte }}" step="0.01" data-disponible="{{ reglement.montantNonAffecte }}">
									</td>

								</tr>

							{% endfor %}

						</tbody>

					</table>


				{% else %}

					<div class="alert alert-secondary mb-0">
						Aucun crédit disponible pour ce fournisseur.
					</div>

				{% endif %}

				<div class="row mt-4">
					<div class="col-md-4 ms-auto">

						<table class="table table-sm">

							<tr>
								<th>Reste facture</th>
								<td id="reste-facture" class="text-end" data-reste="{{ facture.resteAPayer }}">
									{{ facture.resteAPayer|number_format(2, ',', ' ') }}
									€
								</td>
							</tr>

							<tr>
								<th>Crédit utilisé</th>
								<td id="credit-utilise" class="text-end">
									0,00 €
								</td>
							</tr>

							<tr>
								<th>Nouveau paiement</th>
								<td id="nouveau-paiement" class="text-end fw-bold">
									{{ facture.resteAPayer|number_format(2, ',', ' ') }}
									€
								</td>
							</tr>

						</table>

					</div>
				</div>

			</div>

		</div>

		<div class="card">

			<div class="card-header">
				Nouveau paiement
			</div>

			<div class="card-body">

				{{ form_start(form) }}

				<div class="d-flex justify-content-between align-items-center gap-3 mb-3">
					{{ form_label(form.montant) }}
					{{ form_widget(form.montant) }}
					{{ form_label(form.dateReglement) }}
					{{ form_widget(form.dateReglement) }}
				</div>

				<button class="btn btn-success">
					Enregistrer le règlement
				</button>

				{{ form_end(form) }}

			</div>

		</div>

		<a href="{{ path('app_facture_fournisseur_index') }}" class="btn btn-secondary mt-3">
			Annuler
		</a>

	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	<script src="{{ asset('assets/js/facture_fournisseur/regler.js') }}"></script>
{% endblock %}
