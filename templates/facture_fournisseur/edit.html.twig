{% extends 'base.html.twig' %}

{% block title %}
    Modifier une facture fournisseur
{% endblock %}

{% block body %}

    <h1>Modifier une facture fournisseur</h1>

    {{ include(
        'facture_fournisseur/_form.html.twig',
        {
            'button_label': 'Comptabiliser'
        }
    ) }}

    <a
        href="{{ path('app_facture_fournisseur_index') }}"
        class="btn btn-secondary"
    >
        Annuler
    </a>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/js/factureFournisseur.js') }}"></script>
{% endblock %}