{% extends 'base.html.twig' %}

{% block title %}
	Facture fournisseur
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">

			<h1>
				Facture fournisseur
			</h1>

			<div class="d-flex gap-2">

				{% if
                    facture_fournisseur.comptabilisee
                    and not facture_fournisseur.exercice.cloture
                    and facture_fournisseur.coproprietaireAvanceur is null
                %}
					<a class="btn btn-outline-warning" href="{{ path('app_facture_fournisseur_corriger_montant', { id: facture_fournisseur.id }) }}">
						Corriger montant
					</a>
				{% endif %}

				<a class="btn btn-outline-secondary" href="{{ path('app_facture_fournisseur_index') }}">
					Retour
				</a>

			</div>

		</div>

		<div class="card shadow-sm">
			<div class="card-body">

				<table class="table table-sm">

					<tr>
						<th style="width: 250px;">
							Id
						</th>
						<td>
							{{ facture_fournisseur.id }}
						</td>
					</tr>

					<tr>
						<th style="width: 250px;">
							Numéro
						</th>
						<td>
							{{ facture_fournisseur.numero ?: '—' }}
						</td>
					</tr>

					<tr>
						<th>Date</th>
						<td>
							{{ facture_fournisseur.dateFacture
                                ? facture_fournisseur.dateFacture|date('d/m/Y')
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Fournisseur</th>
						<td>
							{{ facture_fournisseur.fournisseur
                                ? facture_fournisseur.fournisseur.nom
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Libellé</th>
						<td>
							{{ facture_fournisseur.libelle }}
						</td>
					</tr>

					<tr>
						<th>Type de charge</th>
						<td>
							{{ facture_fournisseur.typeCharge
                                ? facture_fournisseur.typeCharge.nom
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Montant</th>
						<td>
							{{ facture_fournisseur.montant|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>Copropriétaire avanceur</th>
						<td>
							{{ facture_fournisseur.coproprietaireAvanceur
                                ? facture_fournisseur.coproprietaireAvanceur
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Comptabilisée</th>
						<td>
							{% if facture_fournisseur.comptabilisee %}
								<span class="badge bg-success">
									Oui
								</span>
							{% else %}
								<span class="badge bg-warning text-dark">
									Non
								</span>
							{% endif %}
						</td>
					</tr>

					<tr>
						<th>Exercice</th>
						<td>
							{{ facture_fournisseur.exercice.nom }}
						</td>
					</tr>

					<tr>
						<th>Opération comptable</th>
						<td>
							{% if facture_fournisseur.operation %}
								{{ facture_fournisseur.operation.id }}
							{% else %}
								—
							{% endif %}
						</td>
					</tr>
					<tr>
						<th>Type</th>
						<td>
							{{ facture_fournisseur.estAvoir
							? "Avoir"
							: "Facture"
						}}
						</td>
					</tr>

				</table>

			</div>
		</div>

	</div>

{% endblock %}
