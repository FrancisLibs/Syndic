{% extends 'base.html.twig' %}

{% block title %}
	Facture fournisseur
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<div class="d-flex justify-content-between align-items-center mb-4">

			<h1>
				Facture fournisseur
			</h1>

			<div class="d-flex gap-2">

				{% if
                    facture_fournisseur.comptabilisee
                    and not facture_fournisseur.exercice.cloture
                    and facture_fournisseur.coproprietaireAvanceur is null
                %}
					<a class="btn btn-outline-warning" href="{{ path('app_facture_fournisseur_corriger_montant', { id: facture_fournisseur.id }) }}">
						Corriger montant
					</a>
				{% endif %}

				<a class="btn btn-outline-secondary" href="{{ path('app_facture_fournisseur_index') }}">
					Retour
				</a>

			</div>

		</div>

		<div class="card shadow-sm">
			<div class="card-body">

				<table class="table table-sm">

					<tr>
						<th style="width: 250px;">
							Id
						</th>
						<td>
							{{ facture_fournisseur.id }}
						</td>
					</tr>

					<tr>
						<th style="width: 250px;">
							Numéro
						</th>
						<td>
							{{ facture_fournisseur.numero ?: '—' }}
						</td>
					</tr>

					<tr>
						<th>Date</th>
						<td>
							{{ facture_fournisseur.dateFacture
                                ? facture_fournisseur.dateFacture|date('d/m/Y')
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Fournisseur</th>
						<td>
							{{ facture_fournisseur.fournisseur
                                ? facture_fournisseur.fournisseur.nom
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Libellé</th>
						<td>
							{{ facture_fournisseur.libelle }}
						</td>
					</tr>

					<tr>
						<th>Type de charge</th>
						<td>
							{{ facture_fournisseur.typeCharge
                                ? facture_fournisseur.typeCharge.nom
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Montant</th>
						<td>
							{{ facture_fournisseur.montant|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>Copropriétaire avanceur</th>
						<td>
							{{ facture_fournisseur.coproprietaireAvanceur
                                ? facture_fournisseur.coproprietaireAvanceur
                                : '—'
                            }}
						</td>
					</tr>

					<tr>
						<th>Comptabilisée</th>
						<td>
							{% if facture_fournisseur.comptabilisee %}
								<span class="badge bg-success">
									Oui
								</span>
							{% else %}
								<span class="badge bg-warning text-dark">
									Non
								</span>
							{% endif %}
						</td>
					</tr>

					<tr>
						<th>Exercice</th>
						<td>
							{{ facture_fournisseur.exercice.nom }}
						</td>
					</tr>

					<tr>
						<th>Opération comptable</th>
						<td>
							{% if facture_fournisseur.operation %}
								{{ facture_fournisseur.operation.id }}
							{% else %}
								—
							{% endif %}
						</td>
					</tr>
					<tr>
						<th>Type</th>
						<td>
							{{ facture_fournisseur.estAvoir
							? "Avoir"
							: "Facture"
						}}
						</td>
					</tr>

				</table>

			</div>
		</div>

		{% if facture_fournisseur.comptabilisee
    and facture_fournisseur.estFacture
    and not facture_fournisseur.fnp
    and facture_fournisseur.coproprietaireAvanceur is null %}

			<div class="card shadow-sm mt-4">

				<div class="card-header">
					<h5 class="mb-0">
						Règlements de la facture
					</h5>
				</div>

				<div class="card-body">

					<div class="row mb-4">

						<div class="col-md-4">
							<strong>Montant de la facture</strong>
							<div>
								{{ facture_fournisseur.montant|number_format(2, ',', ' ') }} €
							</div>
						</div>

						<div class="col-md-4">
							<strong>Montant réglé</strong>
							<div>
								{{ facture_fournisseur.montantRegle|number_format(2, ',', ' ') }} €
							</div>
						</div>

						<div class="col-md-4">
							<strong>Reste à régler</strong>
							<div>
								{{ facture_fournisseur.resteARegler|number_format(2, ',', ' ') }} €
							</div>
						</div>

					</div>

					{% if facture_fournisseur.affectationsReglement is not empty %}

						<h6>Règlements déjà affectés</h6>

						<table class="table table-sm table-striped">

							<thead>
								<tr>
									<th>Date</th>
									<th>Référence</th>
									<th class="text-end">Montant affecté</th>
								</tr>
							</thead>

							<tbody>
								{% for affectation in facture_fournisseur.affectationsReglement %}
									<tr>
										<td>
											{{ affectation.reglement.dateReglement|date('d/m/Y') }}
										</td>

										<td>
											{{ affectation.reglement.reference ?: '—' }}
										</td>

										<td class="text-end">
											{{ affectation.montant|number_format(2, ',', ' ') }} €
										</td>
									</tr>
								{% endfor %}
							</tbody>

						</table>

					{% endif %}

					{% if facture_fournisseur.estSoldee %}

						<div class="alert alert-success mb-0">
							Cette facture est intégralement réglée.
						</div>

					{% elseif facture_fournisseur.exercice.cloture %}

						<div class="alert alert-secondary mb-0">
							Exercice clôturé : affectations en consultation uniquement.
						</div>

					{% elseif reglements is not empty %}

						<h6 class="mt-4">
							Règlements disponibles
						</h6>

						<form
							method="post"
							action="{{ path('app_facture_fournisseur_affecter_reglements', {
                        id: facture_fournisseur.id
                    }) }}"
						>

							<input
								type="hidden"
								name="_token"
								value="{{ csrf_token('affecter-reglements-facture-' ~ facture_fournisseur.id) }}"
							>

							<table class="table table-sm table-striped align-middle">

								<thead>
									<tr>
										<th>Date</th>
										<th>Référence</th>
										<th class="text-end">Montant du règlement</th>
										<th class="text-end">Disponible</th>
										<th class="text-center">Affecter</th>
									</tr>
								</thead>

								<tbody>
									{% for reglement in reglements %}
										<tr>
											<td>
												{{ reglement.dateReglement|date('d/m/Y') }}
											</td>

											<td>
												{{ reglement.reference ?: '—' }}
											</td>

											<td class="text-end">
												{{ reglement.montant|number_format(2, ',', ' ') }} €
											</td>

											<td class="text-end">
												{{ reglement.montantNonAffecte|number_format(2, ',', ' ') }} €
											</td>

											<td class="text-center">
												<input
													type="checkbox"
													class="form-check-input"
													name="reglements[]"
													value="{{ reglement.id }}"
												>
											</td>
										</tr>
									{% endfor %}
								</tbody>

							</table>

							<div class="d-flex justify-content-end mt-3">
								<button type="submit" class="btn btn-primary">
									Enregistrer les affectations
								</button>
							</div>

						</form>

					{% else %}

						<div class="alert alert-info mb-0">
							Aucun règlement disponible pour cette facture.
						</div>

					{% endif %}

				</div>

			</div>

		{% endif %}

	</div>

{% endblock %}
