{% extends 'base.html.twig' %}

{% block title %}
	Correction facture fournisseur
{% endblock %}

{% block body %}

	<h1>Correction du montant</h1>

	<div class="card shadow-sm mb-4">

		<div class="card-header">
			Facture
			{{ facture.numero }}
		</div>

		<div class="card-body">

			<dl class="row mb-0">

				<dt class="col-sm-4">
					Fournisseur
				</dt>
				<dd class="col-sm-8">
					{{ facture.fournisseur.nom }}
				</dd>

				<dt class="col-sm-4">
					Libellé
				</dt>
				<dd class="col-sm-8">
					{{ facture.libelle }}
				</dd>

				<dt class="col-sm-4">
					Date
				</dt>
				<dd class="col-sm-8">
					{{ facture.dateFacture|date('d/m/Y') }}
				</dd>

				<dt class="col-sm-4">
					Montant actuel
				</dt>
				<dd class="col-sm-8 fw-semibold">
					{{ facture.montant|number_format(2, ',', ' ') }}
					€
				</dd>
			</dl>

		</div>

	</div>

	<div class="card shadow-sm">

		<div class="card-header">
			Nouveau montant
		</div>

		<div class="card-body">

			{{ form_start(form) }}

			{{ form_row(form.montant) }}

			<div class="alert alert-warning mt-3">
				Cette correction modifiera également les écritures
				                comptables et les répartitions associées à la facture.
			</div>

			<div class="d-flex justify-content-between mt-4">

				<a href="{{ path( 'app_facture_fournisseur_show', {id: facture.id} ) }}" class="btn btn-secondary">
					Annuler
				</a>

				<button type="submit" class="btn btn-warning">
					Corriger le montant
				</button>

			</div>

			{{ form_end(form) }}

		</div>

	</div>

{% endblock %}
