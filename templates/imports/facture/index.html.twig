{% extends 'base.html.twig' %}

{% block title %}
	Import des documents fournisseurs
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-start align-items-baseline gap-3 mb-4">

		<h1>Import des documents fournisseurs</h1>

		<h2>{{ exercice.nom }}</h2>

	</div>

	<div class="row mb-4">

		<div class="col-md-3">

			<div class="card">

				<div class="card-body">

					<h5>Total lignes</h5>

					<div class="display-6">

						{{ controle.nombreLignes }}

					</div>

				</div>

			</div>

		</div>

		<div class="col-md-3">

			<div class="card">

				<div class="card-body">

					<h5>En attente</h5>

					<div class="display-6 text-primary">

						{{ controle.nombreEnAttente }}

					</div>

				</div>

			</div>

		</div>

		<div class="col-md-3">

			<div class="card">

				<div class="card-body">

					<h5>Importées</h5>

					<div class="display-6 text-success">

						{{ controle.nombreTraitees }}

					</div>

				</div>

			</div>

		</div>

		<div class="col-md-3">

			<div class="card">

				<div class="card-body">

					<h5>Erreurs</h5>

					<div class="display-6 text-danger">

						{{ controle.nombreErreurs }}

					</div>

				</div>

			</div>
		</div>

	</div>

	<div class="alert alert-secondary">

		<strong>Montant total :</strong>

		{{ controle.montantTotal|number_format(2, ',', ' ') }}
		€

	</div>

	{% if controle.nombreErreurs > 0 %}

		<div class="alert alert-warning">
			Certaines lignes doivent être corrigées avant l'import.
		</div>

	{% elseif controle.peutImporter %}

		<div class="alert alert-success d-flex justify-content-start align-items-baseline gap-5">

			Les données sont prêtes à être importées.

			<form method="post" action="{{ path( 'app_import_facture_importer', { id: exercice.id } ) }}">
				<button class="btn btn-success mb-4">
					Importer les documents
				</button>
			</form>

		</div>

	{% elseif controle.nombreTraitees == controle.nombreLignes
    and controle.nombreLignes > 0 %}

		<div class="alert alert-success">
			Tous les documents ont été importés.
		</div>

	{% endif %}

	<table class="table table-striped table-hover">

		<thead>
			<tr>
				<th>Date</th>
				<th>Fournisseur</th>
				<th>Numéro</th>
				<th>Type</th>
				<th>Libellé</th>
				<th class="text-end">Montant</th>
				<th>Statut</th>
				<th>Erreur</th>
			</tr>
		</thead>

		<tbody>

			{% for ligne in controle.lignes %}

				<tr>

					<td>

						{{ ligne.dateFacture|date('d/m/Y') }}

					</td>

					<td>

						{{ ligne.fournisseur }}

					</td>

					<td>

						{{ ligne.numero }}

					</td>

					<td>
						{% if ligne.type.value == 'avoir' %}
							<span class="badge bg-warning text-dark">
								Avoir
							</span>
						{% else %}
							<span class="badge bg-secondary">
								Facture
							</span>
						{% endif %}
					</td>

					<td>

						{{ ligne.libelle }}

					</td>

					<td class="text-end">

						{{ ligne.montant|number_format(2, ',', ' ') }}

					</td>

					<td>

						{% if ligne.estTraitee %}

							<span class="badge bg-success">

								Importée

							</span>

						{% elseif ligne.estEnErreur %}

							<span class="badge bg-danger">

								Erreur

							</span>

						{% elseif ligne.estEnTraitement %}

							<span class="badge bg-warning">

								Traitement

							</span>

						{% else %}

							<span class="badge bg-primary">

								En attente

							</span>

						{% endif %}

					</td>

					<td>

						{{ ligne.erreur }}

					</td>

				</tr>

			{% endfor %}

		</tbody>

	</table>

{% endblock %}
